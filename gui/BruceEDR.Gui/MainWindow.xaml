<Window x:Class="BruceEDR.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BruceEDR.Gui.Views"
        Title="BruceEDR" Height="780" Width="1240"
        MinHeight="560" MinWidth="980"
        Icon="pack://application:,,,/BruceEDR.Gui;component/Assets/bruce.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Ink}"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- F5 refresh, Ctrl+1..9 and Ctrl+0 jump to a view in sidebar order, Ctrl+, opens Settings -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="6"/>
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="7"/>
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="8"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="9"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="10"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="ModePill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource Brush.SafeDim}"/>
            <Setter Property="BorderBrush" Value="#4D34D399"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Padding" Value="7,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMonitorOnly}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Brush.ThreatDim}"/>
                    <Setter Property="BorderBrush" Value="#66F2555A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModePillText" TargetType="TextBlock" BasedOn="{StaticResource Pill.Text}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMonitorOnly}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Toast: slides up and fades in while visible; never takes clicks once hidden -->
        <Style x:Key="Toast" TargetType="Border">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Background" Value="{StaticResource Brush.PanelHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                    <Setter Property="BorderBrush" Value="#99F2555A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ToastVisible}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="12" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource Nav.Rail}"
                    IsEnabled="{Binding TabsEnabled}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- INVESTIGATE: what happened, step by step -->
            <TabItem Header="Incident triage" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+1"
                     v:Nav.Section="INVESTIGATE" v:Nav.Icon="&#xE945;" v:Nav.Flag="AI">
                <v:TriageView DataContext="{Binding Triage}"/>
            </TabItem>
            <TabItem Header="Process map" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+2"
                     v:Nav.Icon="&#xE8CE;" v:Nav.Badge="{Binding ProcessMapBadge}" v:Nav.BadgeLevel="watch">
                <v:ProcessMapView DataContext="{Binding ProcessMap}"/>
            </TabItem>
            <TabItem Header="File map" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+3"
                     v:Nav.Icon="&#xE8A5;" v:Nav.Badge="{Binding FileMapBadge}" v:Nav.BadgeLevel="threat">
                <v:FileMapView DataContext="{Binding FileMap}"/>
            </TabItem>

            <!-- MONITOR: how things look right now -->
            <TabItem Header="Dashboard" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+4"
                     v:Nav.Section="MONITOR" v:Nav.Icon="&#xE80F;" v:Nav.Badge="{Binding FlaggedCount}" v:Nav.BadgeLevel="{Binding DashboardBadgeLevel}">
                <v:DashboardView/>
            </TabItem>
            <TabItem Header="Live events" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+5"
                     v:Nav.Icon="&#xE81C;" v:Nav.Badge="{Binding UnreadAlerts}" v:Nav.BadgeLevel="{Binding UnreadLevel}">
                <v:EventsView/>
            </TabItem>
            <TabItem Header="Insights" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+6"
                     v:Nav.Icon="&#xE9D2;">
                <v:InsightsView DataContext="{Binding Insights}"/>
            </TabItem>

            <!-- NETWORK -->
            <TabItem Header="API surface" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+7"
                     v:Nav.Section="NETWORK" v:Nav.Icon="&#xE71B;" v:Nav.Badge="{Binding BeaconCount}" v:Nav.BadgeLevel="watch">
                <v:SurfaceView/>
            </TabItem>
            <TabItem Header="Network map" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+8"
                     v:Nav.Icon="&#xE909;">
                <v:MapView/>
            </TabItem>

            <!-- CONFIGURE -->
            <TabItem Header="Watchlist" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+9"
                     v:Nav.Section="CONFIGURE" v:Nav.Icon="&#xE7B3;" v:Nav.Badge="{Binding WatchlistEditor.ArmedCount}">
                <v:WatchlistView DataContext="{Binding WatchlistEditor}"/>
            </TabItem>
            <TabItem Header="Coverage" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+0"
                     v:Nav.Icon="&#xE8A9;">
                <v:CoverageView/>
            </TabItem>
            <TabItem Header="Settings" Style="{StaticResource Nav.Item}" ToolTip="Ctrl+,"
                     v:Nav.Icon="&#xE713;">
                <v:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>
        </TabControl>

        <!-- Set-up and start stage. It covers the app whenever nothing is live, so opening
             BruceEDR never starts monitoring: going live is the Start button on this panel. -->
        <v:SetupView Grid.Row="0"
                     Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="0" Style="{StaticResource Toast}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,18" MaxWidth="420" CornerRadius="8" BorderThickness="1" Padding="14,10">
            <Border.RenderTransform>
                <TranslateTransform Y="12"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Top" Margin="0,1,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Text" Value="&#xE946;"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                    <Setter Property="Text" Value="&#xE783;"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ToastText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </Border>

        <!-- Status bar: is the agent alive and keeping up? -->
        <Border Grid.Row="1" Height="34" Background="{StaticResource Brush.InkRaised}"
                BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Grid Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource Halo}">
                            <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Style="{StaticResource LiveDot}"/>
                    </Grid>
                    <TextBlock Text="{Binding RailStatus}" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush.Paper}"/>
                    <Border Style="{StaticResource ModePill}"
                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ModeText}" Style="{StaticResource ModePillText}"/>
                    </Border>
                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Padding="7,1"
                            Background="{StaticResource Brush.AccentDim}" BorderBrush="{StaticResource Brush.AccentLine}"
                            Visibility="{Binding IsReplay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="REPLAY" Style="{StaticResource Pill.Text}" Foreground="{StaticResource Brush.Accent}"/>
                    </Border>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="SIGNALS/SEC" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding SignalRate}" Style="{StaticResource Metric.Value}"
                               Foreground="{StaticResource Brush.Accent}"/>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="PROCESSED" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding SignalsProcessed}" Style="{StaticResource Metric.Value}"/>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="P95" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding LatencyP95}" Style="{StaticResource Metric.Value}"/>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="RULES" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding RuleCount}" Style="{StaticResource Metric.Value}"/>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="IOCS" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding IndicatorCount}" Style="{StaticResource Metric.Value}"/>

                    <!-- Dropped telemetry is a detection gap, not a performance note -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasDroppedSignals, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Metric.Sep}"/>
                        <TextBlock Text="DROPPED" Style="{StaticResource Metric.Label}"
                                   Foreground="{StaticResource Brush.Watch}"/>
                        <TextBlock Text="{Binding DroppedSignals}" Style="{StaticResource Metric.Value}"
                                   Foreground="{StaticResource Brush.Watch}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Monitors}" Margin="14,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontFamily="{StaticResource Font.Data}" FontSize="10.5"
                           Foreground="{StaticResource Brush.Faint}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Monitors}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="UPTIME" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding Uptime}" Style="{StaticResource Metric.Value}"/>
                    <Border Style="{StaticResource Metric.Sep}"/>
                    <Button Content="{Binding StopLabel}" Style="{StaticResource Btn.Subtle}" Padding="10,2" FontSize="11"
                            VerticalAlignment="Center" Command="{Binding StopCommand}"
                            ToolTip="Stop and return to set-up"
                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Set up and start" Style="{StaticResource Btn.Primary}" Padding="10,2" FontSize="11"
                            VerticalAlignment="Center" Command="{Binding OpenSetupCommand}"
                            Visibility="{Binding ShowStartPrompt, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
