<Window x:Class="BruceEDR.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BruceEDR.Gui.Views"
        Title="BruceEDR" Height="780" Width="1240"
        MinHeight="560" MinWidth="980"
        Icon="pack://application:,,,/BruceEDR.Gui;component/Assets/bruce.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Ink}"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- Analyst muscle-memory shortcuts: F5 refresh, Ctrl+1..5 jump to a view -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="6"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource Nav.Rail}"
                    IsEnabled="{Binding TabsEnabled}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Dashboard" Style="{StaticResource Nav.Item}">
                <v:DashboardView/>
            </TabItem>
            <TabItem Header="Live events" Style="{StaticResource Nav.Item}">
                <v:EventsView/>
            </TabItem>
            <TabItem Header="API surface" Style="{StaticResource Nav.Item}">
                <v:SurfaceView/>
            </TabItem>
            <TabItem Header="Network map" Style="{StaticResource Nav.Item}">
                <v:MapView/>
            </TabItem>
            <TabItem Header="Watchlist" Style="{StaticResource Nav.Item}">
                <v:WatchlistView DataContext="{Binding WatchlistEditor}"/>
            </TabItem>
            <TabItem Header="Coverage" Style="{StaticResource Nav.Item}">
                <v:CoverageView/>
            </TabItem>
            <TabItem Header="Settings" Style="{StaticResource Nav.Item}">
                <v:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>
        </TabControl>

        <!-- Set-up and start stage. It covers the app whenever nothing is live, so opening
             BruceEDR never starts monitoring: going live is the Start button on this panel. -->
        <v:SetupView Grid.Row="0"
                     Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}"/>

        <!-- Live telemetry status bar: monitor health, throughput, detection latency,
             uptime. The one strip that answers "is the agent alive and keeping up?" -->
        <Border Grid.Row="1" Height="32" Background="{StaticResource Brush.InkRaised}"
                BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Threat}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Safe}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                               FontSize="11" FontWeight="Medium">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
                                <Setter Property="Text" Value="Not monitoring"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Text" Value="Monitoring"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Which response mode is live: green while it only reports, red while it acts. -->
                    <TextBlock Text="{Binding ModeText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="10.5" FontWeight="SemiBold"
                               Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitorOnly}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="SIGNALS/SEC" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding SignalRate}" Style="{StaticResource Metric.Value}"
                               Foreground="{StaticResource Brush.Accent}"/>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="PROCESSED" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding SignalsProcessed}" Style="{StaticResource Metric.Value}"/>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="P95" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding LatencyP95}" Style="{StaticResource Metric.Value}"/>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="RULES" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding RuleCount}" Style="{StaticResource Metric.Value}"/>

                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="IOCS" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding IndicatorCount}" Style="{StaticResource Metric.Value}"/>

                    <!-- Dropped telemetry is a detection gap, not a performance note -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasDroppedSignals, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Metric.Sep}"/>
                        <TextBlock Text="DROPPED" Style="{StaticResource Metric.Label}"
                                   Foreground="{StaticResource Brush.Watch}"/>
                        <TextBlock Text="{Binding DroppedSignals}" Style="{StaticResource Metric.Value}"
                                   Foreground="{StaticResource Brush.Watch}"/>
                    </StackPanel>
                </StackPanel>

                <!-- The monitor list is the one item that gives way: it trims instead of
                     running into the metrics at narrow widths. -->
                <TextBlock Grid.Column="1" Text="{Binding Monitors}" Margin="14,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontFamily="{StaticResource Font.Data}" FontSize="10.5"
                           Foreground="{StaticResource Brush.Faint}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Monitors}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Style="{StaticResource Metric.Sep}"/>
                    <TextBlock Text="UPTIME" Style="{StaticResource Metric.Label}"/>
                    <TextBlock Text="{Binding Uptime}" Style="{StaticResource Metric.Value}"/>
                    <Border Style="{StaticResource Metric.Sep}"/>
                    <Button Content="Stop monitoring" Style="{StaticResource Btn.Subtle}" Padding="10,2" FontSize="11"
                            VerticalAlignment="Center" Command="{Binding StopCommand}"
                            ToolTip="Stop the engine and return to set-up"
                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Set up and start" Style="{StaticResource Btn.Primary}" Padding="10,2" FontSize="11"
                            VerticalAlignment="Center" Command="{Binding OpenSetupCommand}"
                            Visibility="{Binding ShowStartPrompt, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
