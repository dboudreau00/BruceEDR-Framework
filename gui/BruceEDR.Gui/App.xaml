<Application x:Class="BruceEDR.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BruceEDR.Gui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:NotToVisibilityConverter x:Key="NotToVis"/>
            <local:EqualsConverter x:Key="Equals"/>
            <local:LevelBrushConverter x:Key="LevelBrush"/>
            <local:LevelBrushConverter x:Key="LevelDim" Dim="True"/>
            <local:ChipSelectedConverter x:Key="ChipSelected"/>
            <local:TacticSummaryConverter x:Key="TacticSummary"/>
            <local:TacticProgressConverter x:Key="TacticProgress"/>
            <local:LessThanConverter x:Key="LessThan"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
