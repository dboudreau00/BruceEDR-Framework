<UserControl x:Class="BruceEDR.Gui.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Ink}">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- The whole card is the click target; the accent border and dot show the choice. -->
        <Style x:Key="ModeOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{StaticResource Brush.InkRaised}"
                                BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,12,0">
                                    <Ellipse x:Name="ring" Stroke="{StaticResource Brush.Faint}" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Brush.Accent}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,24,22,20">
        <StackPanel MaxWidth="760" HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Image Source="pack://application:,,,/BruceEDR.Gui;component/Assets/bruce_256.png"
                       Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Set up BruceEDR" Style="{StaticResource Text.Display}"/>
                    <TextBlock Text="Nothing is being monitored yet. Check these settings, then press Start."
                               Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- A config that exists but cannot be parsed blocks Start, as the console does. -->
            <Border Style="{StaticResource SectionCard}" Background="{StaticResource Brush.ThreatDim}"
                    BorderBrush="{StaticResource Brush.Threat}"
                    Visibility="{Binding Setup.HasLoadError, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="The configuration file has a problem" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="{Binding Setup.LoadError}" Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="After fixing it, reopen BruceEDR. Nothing was changed on disk."
                               Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>

            <!-- Response mode -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="When BruceEDR finds something" Style="{StaticResource Text.Title}" Margin="0,0,0,4"/>
                    <TextBlock Text="You can change this later in Settings. It applies live."
                               Style="{StaticResource Caption}" Margin="0,0,0,14"/>

                    <RadioButton GroupName="mode" Style="{StaticResource ModeOption}" IsChecked="{Binding Setup.Monitor}"
                                 AutomationProperties.Name="Monitor only">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Monitor only" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="RECOMMENDED" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Safe}"
                                           Margin="10,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Brush.Mist}"
                                       Text="Detects and logs threats, and shows what it would have done. It never suspends, blocks, quarantines or ends a process on its own."/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="mode" Style="{StaticResource ModeOption}" IsChecked="{Binding Setup.Enforce}"
                                 AutomationProperties.Name="Enforce" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Enforce" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Brush.Mist}"
                                       Text="Runs the response playbook by itself: high-scoring unsigned processes are suspended, cut off the network and have their staged files quarantined."/>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Brush.Watch}"
                                       Text="Watch monitor mode on this machine first. Unsigned tools you build or run yourself can score high."/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Trust -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Trusted publishers" Style="{StaticResource Text.Title}" Margin="0,0,0,4"/>
                    <TextBlock Text="Software with a valid signature from these publishers scores lower. One name per line, exactly as it appears on the signature."
                               Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                    <TextBox Style="{StaticResource Input}" Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Text="{Binding Setup.Publishers}"
                             AutomationProperties.Name="Trusted publishers"/>
                </StackPanel>
            </Border>

            <!-- Thresholds -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Scores" Style="{StaticResource Text.Title}" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="WARN AT SCORE" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Width="130" HorizontalAlignment="Left"
                                     Text="{Binding Setup.WarnThreshold}" AutomationProperties.Name="Warn at score"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="CONTAIN AT SCORE" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Width="130" HorizontalAlignment="Left"
                                     Text="{Binding Setup.QuarantineThreshold}" AutomationProperties.Name="Contain at score"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="In monitor mode, contain means it is only reported." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Setup.RulesSummary}" TextWrapping="Wrap" Margin="2,0,0,14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Setup.RulesMissing}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,0">
                <Run Text="Settings file:"/>
                <Run Text="{Binding Setup.ConfigPath, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>

    <!-- Pinned so Start is never below the fold, whatever the window height. -->
    <Border Grid.Row="1" Background="{StaticResource Brush.InkRaised}" BorderBrush="{StaticResource Brush.Line}"
            BorderThickness="0,1,0,0" Padding="22,12">
        <Grid MaxWidth="760">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Command="{Binding StartCommand}" Padding="20,9">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                            <Setter Property="Content" Value="Start monitoring"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Setup.Enforce}" Value="True">
                                    <Setter Property="Content" Value="Start in enforce mode"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="All settings" Style="{StaticResource Btn.Subtle}" Margin="10,0,0,0"
                        ToolTip="Saves these choices and opens the full Settings page without starting anything"
                        Command="{Binding ReviewSettingsCommand}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Setup.Message}" Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Mist}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0"
                       Visibility="{Binding Setup.HasMessage, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Border>
    </Grid>
</UserControl>
