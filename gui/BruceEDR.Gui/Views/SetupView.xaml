<UserControl x:Class="BruceEDR.Gui.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Ink}">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.AccentDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The whole card is the click target; the accent border and dot show the choice. -->
        <Style x:Key="ModeOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{StaticResource Brush.InkRaised}"
                                BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                                CornerRadius="10" Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,12,0">
                                    <Ellipse x:Name="ring" Stroke="{StaticResource Brush.Faint}" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Brush.Accent}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="bd" Property="Background" Value="#0F7C6CFF"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Replay scenario card in a ListBox, so selection and keyboard come for free -->
        <Style x:Key="ScenarioItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource Brush.InkRaised}" BorderBrush="{StaticResource Brush.Line}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="bd" Property="Background" Value="#0F7C6CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,24,24,16">
            <Grid MaxWidth="1040" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="460"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="370"/>
                </Grid.ColumnDefinitions>

                <!-- Hero -->
                <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="58" Height="58" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse Width="96" Height="96" Margin="-19" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#557C6CFF" Offset="0"/>
                                    <GradientStop Color="#007C6CFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border CornerRadius="14" Background="{StaticResource Brush.AccentDim}"
                                BorderBrush="{StaticResource Brush.AccentLine}" BorderThickness="1">
                            <Image Source="pack://application:,,,/BruceEDR.Gui;component/Assets/bruce_256.png"
                                   Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Set up BruceEDR" Style="{StaticResource Text.Display}" FontSize="26"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Faint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Nothing is being monitored yet." Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Mist}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Left: configuration -->
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <Border Style="{StaticResource SectionCard}" Background="{StaticResource Brush.ThreatDim}"
                            BorderBrush="{StaticResource Brush.Threat}"
                            Visibility="{Binding Setup.HasLoadError, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{StaticResource Brush.Threat}" Margin="0,0,8,0"/>
                                <TextBlock Text="The configuration file has a problem" Style="{StaticResource Text.Title}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Setup.LoadError}" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="After fixing it, reopen BruceEDR. Nothing was changed on disk."
                                       Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Style="{StaticResource StepText}"/></Border>
                                <TextBlock Text="When BruceEDR finds something" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <RadioButton GroupName="mode" Style="{StaticResource ModeOption}" IsChecked="{Binding Setup.Monitor}"
                                         AutomationProperties.Name="Monitor only">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Monitor only" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="7,0.5"
                                                Background="{StaticResource Brush.SafeDim}" BorderBrush="#4D34D399">
                                            <TextBlock Text="RECOMMENDED" Style="{StaticResource Pill.Text}" FontSize="9"
                                                       Foreground="{StaticResource Brush.Safe}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Brush.Mist}"
                                               Text="Detects and logs threats, and shows what it would have done. It never suspends, blocks, quarantines or ends a process on its own."/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="mode" Style="{StaticResource ModeOption}" IsChecked="{Binding Setup.Enforce}"
                                         AutomationProperties.Name="Enforce" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Enforce" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Brush.Mist}"
                                               Text="Runs the response playbook by itself: high-scoring unsigned processes are suspended, cut off the network and have their staged files quarantined."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="11"
                                                   Foreground="{StaticResource Brush.Watch}" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                        <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Brush.Watch}" Margin="0"
                                                   Text="Watch monitor mode on this machine first. Unsigned tools you build or run yourself can score high."/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Style="{StaticResource StepText}"/></Border>
                                <TextBlock Text="Trusted publishers" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="One name per line, exactly as it appears on the signature."
                                       Style="{StaticResource Caption}" Margin="32,0,0,12"/>
                            <TextBox Style="{StaticResource Input}" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Text="{Binding Setup.Publishers}"
                                     AutomationProperties.Name="Trusted publishers"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Style="{StaticResource StepText}"/></Border>
                                <TextBlock Text="Scores" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="WARN AT SCORE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Width="130" HorizontalAlignment="Left"
                                             FontFamily="{StaticResource Font.Data}"
                                             Validation.ErrorTemplate="{StaticResource Validation.Inline}"
                                             Text="{Binding Setup.WarnThreshold, ValidatesOnExceptions=True}" AutomationProperties.Name="Warn at score"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="CONTAIN AT SCORE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Width="130" HorizontalAlignment="Left"
                                             FontFamily="{StaticResource Font.Data}"
                                             Validation.ErrorTemplate="{StaticResource Validation.Inline}"
                                             Text="{Binding Setup.QuarantineThreshold, ValidatesOnExceptions=True}" AutomationProperties.Name="Contain at score"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="In monitor mode, contain means it is only reported." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: replay + facts -->
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <Border Style="{StaticResource SectionCard}" BorderBrush="{StaticResource Brush.AccentLine}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A7C6CFF" Offset="0"/>
                                <GradientStop Color="#0010141F" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource IconWell}" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Background="{StaticResource Brush.AccentDim}" BorderBrush="{StaticResource Brush.AccentLine}">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Brush.Accent}"/>
                                </Border>
                                <TextBlock Text="Replay a recorded attack" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="38,0,0,12"
                                       Text="Real engine, recorded trace. Nothing on this machine is monitored or touched."/>

                            <ListBox ItemsSource="{Binding Setup.Scenarios}" SelectedItem="{Binding Setup.SelectedScenario, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ScenarioItem}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0"
                                     AutomationProperties.Name="Recorded scenarios">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding Description}">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Paper}" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,64,0"/>
                                                <Border x:Name="kind" HorizontalAlignment="Right" CornerRadius="9" Padding="7,0.5" BorderThickness="1"
                                                        Background="{StaticResource Brush.ThreatDim}" BorderBrush="#4DF2555A">
                                                    <TextBlock x:Name="kindText" Text="{Binding Kind}" Style="{StaticResource Pill.Text}" FontSize="8.5"
                                                               Foreground="{StaticResource Brush.Threat}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Facts}" Margin="0,4,0,0" FontFamily="{StaticResource Font.Data}"
                                                       FontSize="9.5" Foreground="{StaticResource Brush.Faint}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsBenign}" Value="True">
                                                <Setter TargetName="kind" Property="Background" Value="{StaticResource Brush.SafeDim}"/>
                                                <Setter TargetName="kind" Property="BorderBrush" Value="#4D34D399"/>
                                                <Setter TargetName="kindText" Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No recorded scenarios were found beside the app."
                                       Foreground="{StaticResource Brush.Watch}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Setup.HasScenarios}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Style="{StaticResource Btn.Subtle}" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                    BorderBrush="{StaticResource Brush.AccentLine}" Command="{Binding StartReplayCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"
                                               Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Text="Replay selected scenario"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontSize="12" Margin="0,0,9,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Setup.RulesMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Setup.RulesSummary}" TextWrapping="Wrap" MaxWidth="290">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Mist}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Setup.RulesMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,9,0"
                                           Foreground="{StaticResource Brush.Faint}"/>
                                <TextBlock Text="{Binding Setup.ConfigPath}" FontFamily="{StaticResource Font.Data}" FontSize="10"
                                           Foreground="{StaticResource Brush.Faint}" TextWrapping="Wrap" MaxWidth="290"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Pinned so Start is never below the fold, whatever the window height. -->
        <Border Grid.Row="1" Background="{StaticResource Brush.InkRaised}" BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid MaxWidth="1040">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Command="{Binding StartCommand}" Padding="20,9">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Start monitoring"/>
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Setup.Enforce}" Value="True">
                                        <Setter Property="Content" Value="Start in enforce mode"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="All settings" Style="{StaticResource Btn.Subtle}" Margin="10,0,0,0"
                            ToolTip="Saves these choices and opens the full Settings page without starting anything"
                            Command="{Binding ReviewSettingsCommand}"/>
                    <Button Style="{StaticResource Btn.Subtle}" Margin="8,0,0,0" Command="{Binding ExploreHistoryCommand}"
                            ToolTip="Open the process map, file map and charts of a run you saved earlier. Nothing is started.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Font.Icon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Earlier runs"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Setup.Message}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding Setup.HasMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Mist}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Setup.MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
