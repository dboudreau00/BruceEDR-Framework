<UserControl x:Class="BruceEDR.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource View.Root}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionIcon" TargetType="Border" BasedOn="{StaticResource IconWell}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,11,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.AccentDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
        </Style>
        <Style x:Key="SectionGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
        </Style>
        <Style x:Key="NumberInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Validation.Inline}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Brush.LineSoft}"/>
            <Setter Property="Margin" Value="0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,20,22,8">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                <TextBlock Text="Settings" Style="{StaticResource Text.Display}" Margin="0,0,0,16"/>

                <!-- Response -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xEA18;" Style="{StaticResource SectionGlyph}"/>
                            </Border>
                            <TextBlock Text="Response" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Act on threats automatically (enforce mode)" Style="{StaticResource Text.Body}"/>
                                    <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="7,1"
                                            Background="{StaticResource Brush.ThreatDim}" BorderBrush="#66F2555A"
                                            Visibility="{Binding Enforce, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="ENFORCING" Style="{StaticResource Pill.Text}" Foreground="{StaticResource Brush.Threat}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Off is monitor mode: threats are logged with what would have been done, and nothing is suspended, blocked, quarantined or ended. Applies live."
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding Enforce}" AutomationProperties.Name="Enforce mode"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <StackPanel Margin="0,0,150,0">
                                <TextBlock Text="Remove BruceEDR firewall rules" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Outbound blocks stay in Windows Firewall after BruceEDR stops. Removing them also lifts host isolation that BruceEDR applied."
                                           Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding FirewallMessage}" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Mist}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FirewallFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button Style="{StaticResource Btn.Subtle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding RemoveFirewallRulesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                                    <TextBlock Text="Remove rules"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Detection -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource SectionGlyph}"/>
                            </Border>
                            <TextBlock Text="Detection" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,16">
                                <TextBlock Text="WARN AT SCORE" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource NumberInput}" AutomationProperties.Name="Warn at score"
                                         Text="{Binding WarnThreshold, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,16">
                                <TextBlock Text="CONTAIN AT SCORE" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource NumberInput}" AutomationProperties.Name="Contain at score"
                                         Text="{Binding QuarantineThreshold, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="TRUSTED-SIGNER DISCOUNT" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource NumberInput}" AutomationProperties.Name="Trusted-signer discount"
                                         Text="{Binding TrustDiscount, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="CORRELATION WINDOW (SECONDS)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource NumberInput}" AutomationProperties.Name="Correlation window in seconds"
                                         Text="{Binding CorrelationWindowSeconds, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Automatically end confirmed threats" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Enforce mode only. Off (recommended) keeps contained processes suspended so a false positive can be released."
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding AutoKill}" AutomationProperties.Name="Automatically end confirmed threats"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Use YARA memory scanning" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Needs a YARA-enabled build; otherwise the builtin scanner is used."
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding UseYara}" AutomationProperties.Name="Use YARA memory scanning"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Allowlist -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource SectionGlyph}"/>
                            </Border>
                            <TextBlock Text="Trusted publishers" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="PUBLISHER NAMES (ONE PER LINE)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" Height="84" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Text="{Binding Publishers}"
                                 AutomationProperties.Name="Trusted publisher names"/>

                        <TextBlock Text="PINNED THUMBPRINTS (ONE SHA-1 PER LINE)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource Input}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Text="{Binding Thumbprints}"
                                 FontFamily="{StaticResource Font.Data}" AutomationProperties.Name="Pinned thumbprints"/>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <TextBlock Text="Allow publisher-name match" Style="{StaticResource Text.Body}"/>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding AllowSubjectMatch}"
                                          AutomationProperties.Name="Allow publisher-name match"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Check certificate revocation" Style="{StaticResource Text.Body}"/>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding CheckRevocation}"
                                          AutomationProperties.Name="Check certificate revocation"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Telemetry -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE724;" Style="{StaticResource SectionGlyph}"/>
                            </Border>
                            <TextBlock Text="Alert forwarding" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <TextBlock Text="Send events to syslog" Style="{StaticResource Text.Body}"/>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding SyslogEnabled}"
                                          AutomationProperties.Name="Send events to syslog"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="HOST" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource Input}" Text="{Binding SyslogHost}" FontFamily="{StaticResource Font.Data}"
                                         AutomationProperties.Name="Syslog host"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="PORT" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource NumberInput}" Width="Auto" HorizontalAlignment="Stretch"
                                         Text="{Binding SyslogPort, ValidatesOnExceptions=True}" AutomationProperties.Name="Syslog port"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <TextBlock Text="TCP" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                                           VerticalAlignment="Center" Margin="0,0,8,7"/>
                                <ToggleButton Style="{StaticResource Switch}" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                              IsChecked="{Binding SyslogTcp}" AutomationProperties.Name="Use TCP for syslog"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <TextBlock Text="Send events to a webhook (SIEM)" Style="{StaticResource Text.Body}"/>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding WebhookEnabled}"
                                          AutomationProperties.Name="Send events to a webhook"/>
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="WEBHOOK URL" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding WebhookUrl}" FontFamily="{StaticResource Font.Data}"
                                     AutomationProperties.Name="Webhook URL"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Kernel -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE950;" Style="{StaticResource SectionGlyph}"/>
                            </Border>
                            <TextBlock Text="Kernel enforcement" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Block access via the minifilter driver" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Needs the signed BruceFilter driver. Refuses browser and wallet stores to any program not trusted for them, which can include an app installed per user."
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Brush.Watch}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding KernelBlocking}" AutomationProperties.Name="Kernel blocking"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Interface -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource SectionGlyph}"/>
                            </Border>
                            <TextBlock Text="Interface" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Keep monitoring from the tray when minimized" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Containments raise a notification while the window is hidden. Applies immediately."
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding MinimizeToTray}" AutomationProperties.Name="Minimize to tray"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Subtle}" ToolTip="Reveal gui.log in File Explorer" Command="{Binding OpenLogCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                                    <TextBlock Text="Open app log"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Subtle}" Margin="10,0,0,0" ToolTip="Reveal bruce.config.json in File Explorer"
                                    Command="{Binding OpenConfigCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                                    <TextBlock Text="Open config file"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,0"><TextBlock Text="F5" Style="{StaticResource Pill.Text}"/></Border>
                            <TextBlock Text="refresh" Style="{StaticResource Caption}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,0"><TextBlock Text="Ctrl+1 to Ctrl+0" Style="{StaticResource Pill.Text}"/></Border>
                            <TextBlock Text="switch views" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Assistant: folded away at the very end on purpose -->
                <Button Style="{StaticResource Btn.Fold}" Command="{Binding ToggleAssistantCommand}" Margin="0,4,0,10"
                        AutomationProperties.Name="Assistant settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="9" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE76C;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AssistantOpen}" Value="True">
                                            <Setter Property="Text" Value="&#xE70D;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Assistant"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding AssistantOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel DataContext="{Binding Assistant}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE945;" Style="{StaticResource SectionGlyph}"/>
                            </Border>
                            <TextBlock Text="Assistant" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="PROVIDER" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource Picker}" ItemContainerStyle="{StaticResource PickerItem}"
                                          ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider, Mode=TwoWay}"
                                          AutomationProperties.Name="Assistant provider"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource Input}" FontFamily="{StaticResource Font.Data}"
                                         Text="{Binding Model, Mode=TwoWay}" AutomationProperties.Name="Assistant model"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="API KEY" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="AssistantKey" Grid.Column="0" Style="{StaticResource Input.Password}"
                                         AutomationProperties.Name="API key"/>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Margin="10,0,0,0"
                                    Command="{Binding DataContext.SaveAssistantKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding ElementName=AssistantKey}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                                    <TextBlock Text="Save key"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding DataContext.AssistantStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Redact user names and secrets" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Incident details go to the provider when an answer is generated."
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding Redact}" AutomationProperties.Name="Redact user names and secrets"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource Btn.Subtle}"
                                    Command="{Binding DataContext.TestAssistantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                                    <TextBlock Text="Test"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Subtle}" Margin="10,0,0,0"
                                    Command="{Binding DataContext.RemoveAssistantKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                                    <TextBlock Text="Remove key"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding DataContext.AssistantMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="420">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.AssistantMessageIsError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Pinned save bar: changes are never more than one click from being saved -->
        <Border Grid.Row="1" Background="{StaticResource Brush.InkRaised}" BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="0,1,0,0" Padding="22,10">
            <Grid MaxWidth="780" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                            <TextBlock Text="Save changes"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Subtle}" Margin="10,0,0,0" Command="{Binding ReloadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                            <TextBlock Text="Reload from disk"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SaveMessage}" VerticalAlignment="Center" Margin="16,0,0,0"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveFailed}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
