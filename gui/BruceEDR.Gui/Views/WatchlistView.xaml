<UserControl x:Class="BruceEDR.Gui.Views.WatchlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource View.Root}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Style x:Key="ActionRail" TargetType="Border">
            <Setter Property="Width" Value="3"/>
            <Setter Property="CornerRadius" Value="1.5"/>
            <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Action}" Value="quarantine">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Brush.Line}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Watchlist" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Margin="10,4,0,0" Cursor="Help"
                           Foreground="{StaticResource Brush.Faint}"
                           ToolTip="Your own detections. A contain-on-sight entry overrides a trusted signature."/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Padding="12,7"
                    Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Watchlist armed"/>
                    <TextBlock Text="Armed" Style="{StaticResource Text.Body}" FontWeight="Medium" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="{StaticResource Brush.Line}" Margin="14,0"/>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AlertOnEveryHit}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Alert on every hit"/>
                    <TextBlock Text="Alert on every hit" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                               Margin="9,0,0,0" VerticalAlignment="Center"
                               ToolTip="Report a match even when the entry only adds points and the process never crosses a threshold."/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,7,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ENTRIES" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Rows.Count}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right"
                            Background="{StaticResource Brush.AccentDim}" BorderBrush="{StaticResource Brush.AccentLine}">
                        <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Accent}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,13" Margin="7,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="CONTAIN ON SIGHT" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ContainCount}" Style="{StaticResource TileValue}"
                                   Foreground="{StaticResource Brush.Threat}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right"
                            Background="{StaticResource Brush.ThreatDim}" BorderBrush="#4DF2555A">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Threat}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,13" Margin="7,0,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ARMED NOW" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ArmedCount}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right"
                            Background="{StaticResource Brush.SafeDim}" BorderBrush="#4D34D399">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Safe}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="26,10,24,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="2*" MinWidth="120"/>
                        <ColumnDefinition Width="124"/>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*" MinWidth="90"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ON" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="1" Text="MATCH" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="2" Text="VALUE" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="3" Text="ACTION" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="4" Text="POINTS" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="5" Text="NOTE" Style="{StaticResource HeaderLabel}"/>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.LineSoft}"/>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource IconWell}" Width="40" Height="40" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="15"
                                       HorizontalAlignment="Center" Foreground="{StaticResource Brush.Faint}"/>
                        </Border>
                        <TextBlock Text="No custom detections yet" Style="{StaticResource Text.Body}" FontWeight="Medium"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Button Style="{StaticResource Btn.Primary}" Margin="0,14,0,0"
                                HorizontalAlignment="Center" Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                                <TextBlock Text="Add an entry"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,7" Margin="2,1" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource ActionRail}" Margin="0,2,9,2"/>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="112"/>
                                                        <ColumnDefinition Width="2*" MinWidth="120"/>
                                                        <ColumnDefinition Width="124"/>
                                                        <ColumnDefinition Width="66"/>
                                                        <ColumnDefinition Width="*" MinWidth="90"/>
                                                        <ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ToggleButton Grid.Column="0" Style="{StaticResource Switch}"
                                                                  Width="28" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                  IsChecked="{Binding Enabled}" AutomationProperties.Name="Entry enabled"/>

                                                    <ComboBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource Picker}"
                                                              ItemContainerStyle="{StaticResource PickerItem}"
                                                              AutomationProperties.Name="Match kind"
                                                              ItemsSource="{Binding DataContext.MatchKinds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding Match, Mode=TwoWay}"/>

                                                    <TextBox Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource Input}"
                                                             FontFamily="{StaticResource Font.Data}" FontSize="11.5"
                                                             AutomationProperties.Name="Value"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                                    <ComboBox Grid.Column="3" Margin="0,0,8,0" Style="{StaticResource Picker}"
                                                              ItemContainerStyle="{StaticResource PickerItem}"
                                                              AutomationProperties.Name="Action"
                                                              ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding Action, Mode=TwoWay}"/>

                                                    <TextBox Grid.Column="4" Margin="0,0,8,0" Style="{StaticResource Input}"
                                                             FontFamily="{StaticResource Font.Data}"
                                                             AutomationProperties.Name="Points"
                                                             Visibility="{Binding IsScoreAction, Converter={StaticResource BoolToVis}}"
                                                             Text="{Binding Score, Mode=TwoWay}"/>

                                                    <TextBox Grid.Column="5" Margin="0,0,8,0" Style="{StaticResource Input}"
                                                             FontSize="11.5" AutomationProperties.Name="Note"
                                                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                                    <Button Grid.Column="6" Content="&#xE74D;" Style="{StaticResource Btn.Icon}"
                                                            Width="28" Height="28" FontSize="11" ToolTip="Remove this entry"
                                                            AutomationProperties.Name="Remove entry"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Margin="44,6,0,0"
                                                            Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="11"
                                                               Foreground="{StaticResource Brush.Threat}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Problem}" FontSize="11"
                                                               Foreground="{StaticResource Brush.Threat}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="44,6,0,0"
                                                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="11"
                                                               Foreground="{StaticResource Brush.Watch}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Warning}" FontSize="11"
                                                               Foreground="{StaticResource Brush.Watch}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Subtle}" Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                        <TextBlock Text="Add entry"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Primary}" Margin="10,0,0,0" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                        <TextBlock Text="Save &amp; arm"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Subtle}" Margin="10,0,0,0" Command="{Binding ReloadCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                        <TextBlock Text="Reload from disk"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Message}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="460" TextAlignment="Right">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
