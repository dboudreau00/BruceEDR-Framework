<UserControl x:Class="BruceEDR.Gui.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:BruceEDR.Gui.Views"
             xmlns:vm="clr-namespace:BruceEDR.Gui.ViewModels"
             x:Name="Root"
             Style="{StaticResource View.Root}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Style x:Key="ChartChip" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Command" Value="{Binding DataContext.SetChartCommand, ElementName=Root}"/>
            <Setter Property="CommandParameter" Value="{Binding Key}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="13,6"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ChipSelected}">
                            <Binding Path="DataContext.Chart" ElementName="Root"/>
                            <Binding Path="Key"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource Brush.AccentDim}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MeasureChip" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Command" Value="{Binding DataContext.SetMeasureCommand, ElementName=Root}"/>
            <Setter Property="CommandParameter" Value="{Binding Key}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ChipSelected}">
                            <Binding Path="DataContext.MeasureKey" ElementName="Root"/>
                            <Binding Path="Key"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource Brush.AccentDim}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChartPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="Legend.Text" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Mist}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Insights" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="The same activity as the maps, as charts. Open an earlier session to compare it with now." Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Faint}" Margin="0,4,0,0"/>
        </StackPanel>

        <v:SourceBar Grid.Row="1" DataContext="{Binding Hub}" Margin="0,0,0,12"/>

        <!-- Numbers for the whole session -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Cards}" Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,13">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Data}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"
                                       Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Text.Body}" FontSize="11" Foreground="{StaticResource Brush.Faint}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Which chart -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{x:Static vm:InsightsViewModel.Choices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Style="{StaticResource ChartChip}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Blurb}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Faint}" Margin="2,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="20,16">
            <Grid>
                <!-- Activity -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource ChartPanel}">
                            <Style.Triggers><DataTrigger Binding="{Binding Chart}" Value="Timeline"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <v:StackedTimeline Data="{Binding Timeline}" MinHeight="220"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="44,12,0,0">
                        <Ellipse Width="8" Height="8" Fill="#4C8DFF" Margin="0,0,7,0"/><TextBlock Text="Processes and modules" Style="{StaticResource Legend.Text}" Margin="0,0,20,0"/>
                        <Ellipse Width="8" Height="8" Fill="#A78BFA" Margin="0,0,7,0"/><TextBlock Text="Files made, moved, deleted" Style="{StaticResource Legend.Text}" Margin="0,0,20,0"/>
                        <Ellipse Width="8" Height="8" Fill="#3A4563" Margin="0,0,7,0"/><TextBlock Text="Files opened" Style="{StaticResource Legend.Text}" Margin="0,0,20,0"/>
                        <Ellipse Width="8" Height="8" Fill="#F2B33D" Margin="0,0,7,0"/><TextBlock Text="Network and DNS" Style="{StaticResource Legend.Text}" Margin="0,0,20,0"/>
                        <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,7,0"/><TextBlock Text="Registry and system" Style="{StaticResource Legend.Text}"/>
                    </StackPanel>
                </Grid>

                <!-- Heatmap -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource ChartPanel}">
                            <Style.Triggers><DataTrigger Binding="{Binding Chart}" Value="Heatmap"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <v:HeatmapChart Data="{Binding Heatmap}" VerticalAlignment="Top" Height="380"/>
                </Grid>

                <!-- Process lifetimes -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource ChartPanel}">
                            <Style.Triggers><DataTrigger Binding="{Binding Chart}" Value="Lifetimes"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <v:LifetimeChart Data="{Binding Lifetimes}"/>
                    </ScrollViewer>
                </Grid>

                <!-- Top processes -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource ChartPanel}">
                            <Style.Triggers><DataTrigger Binding="{Binding Chart}" Value="Processes"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="MEASURE" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ItemsControl ItemsSource="{x:Static vm:InsightsViewModel.Measures}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><Button Content="{Binding Title}" Style="{StaticResource MeasureChip}"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <v:BarList Items="{Binding TopProcesses}" MaxWidth="900" HorizontalAlignment="Left"/>
                            <TextBlock Text="Nothing to rank on this measure yet." Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Faint}"
                                       Visibility="{Binding NoTopProcesses, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Files -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource ChartPanel}">
                            <Style.Triggers><DataTrigger Binding="{Binding Chart}" Value="Files"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="WHAT BECAME OF THEM" Style="{StaticResource Text.Label}" Margin="0,0,0,10"/>
                        <v:DonutChart Slices="{Binding FileMix}" Height="260" Caption="files"/>
                        <TextBlock Text="No file was made, moved or removed." Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Faint}"
                                   Visibility="{Binding NoFiles, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="KINDS OF FILE" Style="{StaticResource Text.Label}" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                            <v:BarList Items="{Binding Extensions}"/>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>

                <!-- Network -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource ChartPanel}">
                            <Style.Triggers><DataTrigger Binding="{Binding Chart}" Value="Network"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="WHERE CONNECTIONS WENT" Style="{StaticResource Text.Label}" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400"><v:BarList Items="{Binding Destinations}"/></ScrollViewer>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NAMES LOOKED UP" Style="{StaticResource Text.Label}" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400"><v:BarList Items="{Binding Domains}"/></ScrollViewer>
                    </StackPanel>
                    <TextBlock Grid.ColumnSpan="3" Text="No network activity was seen." Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Faint}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoNetwork, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Nothing yet -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Background="{StaticResource Brush.Panel}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Brush.AccentDim}" BorderBrush="{StaticResource Brush.AccentLine}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nothing to chart yet" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center">
                        Charts build as the machine is monitored. Start monitoring, replay a recorded attack from the set-up screen, or open an earlier session.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="Open an earlier session..." Style="{StaticResource Btn.Primary}" Command="{Binding Hub.OpenFileCommand}" Margin="0,0,8,0"/>
                        <Button Content="Go to set-up" Style="{StaticResource Btn.Subtle}" Command="{Binding DataContext.OpenSetupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
