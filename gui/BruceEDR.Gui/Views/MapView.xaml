<UserControl x:Class="BruceEDR.Gui.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:BruceEDR.Gui.Views"
             Style="{StaticResource View.Root}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Style x:Key="TransportPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Padding" Value="6,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTls}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SafeDim}"/>
                    <Setter Property="BorderBrush" Value="#4D34D399"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaintext}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.WatchDim}"/>
                    <Setter Property="BorderBrush" Value="#4DF2B33D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TransportText" TargetType="TextBlock" BasedOn="{StaticResource Pill.Text}">
            <Setter Property="FontSize" Value="9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTls}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaintext}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityFill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LegendDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LegendText" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="5,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Network map" Style="{StaticResource Text.Display}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                    <TextBlock Style="{StaticResource Pill.Text}">
                        <Run Text="{Binding MappedCount, Mode=OneWay}"/><Run Text=" countries"/>
                    </TextBlock>
                </Border>
                <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                    <TextBlock Style="{StaticResource Pill.Text}">
                        <Run Text="{Binding TotalEndpointCount, Mode=OneWay}"/><Run Text=" endpoints"/>
                    </TextBlock>
                </Border>
                <Border Style="{StaticResource Pill}" Background="{StaticResource Brush.WatchDim}" BorderBrush="#4DF2B33D">
                    <TextBlock Style="{StaticResource Pill.Text}" Foreground="{StaticResource Brush.Watch}">
                        <Run Text="{Binding BeaconCount, Mode=OneWay}"/><Run Text=" beaconing"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*" MinWidth="270" MaxWidth="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.LineSoft}"
                            BorderThickness="0,0,0,1" Padding="16,10">
                        <WrapPanel VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource Brush.Safe}"/>
                            <TextBlock Text="ok" Style="{StaticResource LegendText}"/>
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource Brush.Watch}"/>
                            <TextBlock Text="watch" Style="{StaticResource LegendText}"/>
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource Brush.Threat}"/>
                            <TextBlock Text="threat" Style="{StaticResource LegendText}"/>
                            <Ellipse Style="{StaticResource LegendDot}" Stroke="{StaticResource Brush.Watch}" StrokeThickness="1"
                                     StrokeDashArray="2 2" Fill="Transparent"/>
                            <TextBlock Text="plaintext http" Style="{StaticResource LegendText}"/>
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource Brush.Accent}"/>
                            <TextBlock Text="arcs start at the region setting" Style="{StaticResource LegendText}"/>
                        </WrapPanel>
                    </Border>

                    <!-- The map is allocation geography, not packet geography; say so where it is read. -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.LineSoft}"
                            BorderThickness="0,1,0,0" Padding="16,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="11"
                                       Foreground="{StaticResource Brush.Faint}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Brush.Faint}"
                                       Text="Markers show where each address block is registered (offline RIR data), not where the host is. CDNs and anycast land in the wrong place. Never attribute from this alone."/>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <v:WorldMapCanvas x:Name="Map" Margin="6"
                                          World="{Binding World}"
                                          Markers="{Binding Markers}"
                                          Home="{Binding Home}"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Markers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource IconWell}" Width="40" Height="40" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE909;" Style="{StaticResource Icon}" FontSize="15"
                                           HorizontalAlignment="Center" Foreground="{StaticResource Brush.Faint}"/>
                            </Border>
                            <TextBlock Text="Nothing plotted yet" Style="{StaticResource Text.Body}" FontWeight="Medium"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.Watch}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding GeoMissing, Converter={StaticResource BoolToVis}}"
                                       Text="The offline geo table is missing from intel\geo. Run tools/build-geo.py to regenerate it."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.LineSoft}"
                            BorderThickness="0,0,0,1" Padding="16,12">
                        <TextBlock Text="Destinations" Style="{StaticResource Text.Title}"/>
                    </Border>

                    <!-- Unplaced tray: never silently drop traffic off the picture -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.LineSoft}"
                            BorderThickness="0,1,0,0" Padding="16,10"
                            Visibility="{Binding Unplaced.HasAny, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="NOT ON THE MAP" Style="{StaticResource Text.Label}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                    <TextBlock Style="{StaticResource Pill.Text}">
                                        <Run Text="{Binding Unplaced.LocalCount, Mode=OneWay}"/><Run Text=" local or reserved"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                    <TextBlock Style="{StaticResource Pill.Text}">
                                        <Run Text="{Binding Unplaced.UnknownCount, Mode=OneWay}"/><Run Text=" unplaced (IPv6, unallocated)"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,0,6,4" Background="{StaticResource Brush.WatchDim}" BorderBrush="#4DF2B33D"
                                        Visibility="{Binding HasHiddenEndpoints, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Pill.Text}" Foreground="{StaticResource Brush.Watch}">
                                        <Run Text="{Binding HiddenEndpointCount, Mode=OneWay}"/><Run Text=" beyond the display cap"/>
                                    </TextBlock>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Markers}" Margin="0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row" Padding="12,9" Margin="6,2" CornerRadius="6"
                                            BorderThickness="1" BorderBrush="Transparent" Background="Transparent"
                                            MouseEnter="Marker_MouseEnter" MouseLeave="Marker_MouseLeave">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" Height="26" CornerRadius="1.5" Margin="0,0,10,0"
                                                        Style="{StaticResource SeverityFill}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Country}" FontWeight="Medium"
                                                                   FontSize="{StaticResource Size.Body}"
                                                                   Foreground="{StaticResource Brush.Paper}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                        <Border Style="{StaticResource Pill}" Padding="5,0" Margin="7,0,0,0">
                                                            <TextBlock Text="{Binding CountryCode}" Style="{StaticResource Pill.Text}" FontSize="9"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Summary}" Margin="0,3,0,0"
                                                               FontSize="10.5" Foreground="{StaticResource Brush.Faint}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Connections}" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource Font.Data}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource Brush.Mist}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Endpoints}" Margin="13,8,0,0"
                                                          Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource TransportPill}" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Transport}" Style="{StaticResource TransportText}"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Endpoint}" FontFamily="{StaticResource Font.Data}"
                                                                           FontSize="10.5" Foreground="{StaticResource Brush.Mist}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Process}" FontSize="10"
                                                                           Foreground="{StaticResource Brush.Faint}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                                            <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
