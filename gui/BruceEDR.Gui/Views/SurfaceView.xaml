<UserControl x:Class="BruceEDR.Gui.Views.SurfaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource View.Root}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Style x:Key="SeverityFill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransportPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Padding" Value="7,1.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTls}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SafeDim}"/>
                    <Setter Property="BorderBrush" Value="#4D34D399"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaintext}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.WatchDim}"/>
                    <Setter Property="BorderBrush" Value="#4DF2B33D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TransportText" TargetType="TextBlock" BasedOn="{StaticResource Pill.Text}">
            <Setter Property="FontSize" Value="9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTls}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaintext}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarFill" TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Beaconing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="API surface" Style="{StaticResource Text.Display}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource Btn.Subtle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="Save the filtered endpoint list as CSV" Command="{Binding ExportSurfaceCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                    <TextBlock Text="Export"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,7,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ENDPOINTS" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TotalEndpointCount}" Style="{StaticResource TileValue}"/>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource Brush.Watch}" Margin="0,2,0,0"
                                   Visibility="{Binding HasHiddenEndpoints, Converter={StaticResource BoolToVis}}">
                            <Run Text="showing"/> <Run Text="{Binding EndpointCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right"
                            Background="{StaticResource Brush.InfoDim}" BorderBrush="#4D4C8DFF">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Info}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,13" Margin="7,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="BEACONING" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BeaconCount}" Style="{StaticResource TileValue}"
                                   Foreground="{StaticResource Brush.Watch}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right"
                            Background="{StaticResource Brush.WatchDim}" BorderBrush="#4DF2B33D">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Watch}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,13" Margin="7,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="COUNTRIES" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MappedCount}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right"
                            Background="{StaticResource Brush.AccentDim}" BorderBrush="{StaticResource Brush.AccentLine}">
                        <TextBlock Text="&#xE909;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Accent}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,13" Margin="7,0,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="PLAINTEXT HTTP" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PlaintextCount}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE785;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Mist}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource Input.Search}" Height="30"
                     ToolTip="Filter by endpoint, address or process"
                     AutomationProperties.Name="Filter endpoints"
                     Text="{Binding SurfaceSearch, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding OnlyBeaconing}"
                              AutomationProperties.Name="Only beaconing"/>
                <TextBlock Text="Only beaconing" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Mist}" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,10,26,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*" MinWidth="90" MaxWidth="170"/>
                        <ColumnDefinition Width="2*" MinWidth="120"/>
                        <ColumnDefinition Width="*" MinWidth="44" MaxWidth="150"/>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="82"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="2" Text="PROCESS" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="3" Text="ENDPOINT" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="4" Text="LOCATION" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="5" Text="PORT" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="6" Text="CONNECTIONS" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="7" Text="CADENCE" Style="{StaticResource HeaderLabel}"/>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.LineSoft}"/>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl ItemsSource="{Binding Surface}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,7" Margin="2,1" CornerRadius="4">
                                        <Border.ToolTip>
                                            <TextBlock>
                                                <Run Text="{Binding Endpoint, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <LineBreak/>
                                                <Run Text="{Binding Location, Mode=OneWay}"/>
                                                <Run Text="  last seen"/> <Run Text="{Binding LastSeen, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border.ToolTip>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*" MinWidth="90" MaxWidth="170"/>
                                                <ColumnDefinition Width="2*" MinWidth="120"/>
                                                <ColumnDefinition Width="*" MinWidth="44" MaxWidth="150"/>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="82"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                                    Style="{StaticResource SeverityFill}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Pid}" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Font.Data}" FontSize="11"
                                                       Foreground="{StaticResource Brush.Faint}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Process}" VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="Medium"
                                                       Foreground="{StaticResource Brush.Paper}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{StaticResource Font.Data}" FontSize="11.5"
                                                           Foreground="{StaticResource Brush.Paper}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Margin="0,1,0,0"
                                                           FontFamily="{StaticResource Font.Data}"
                                                           Foreground="{StaticResource Brush.Faint}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <DockPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0" LastChildFill="True">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" Padding="5,0.5" Margin="0,0,6,0" MinWidth="30">
                                                    <TextBlock Text="{Binding CountryCode}" Style="{StaticResource Pill.Text}" FontSize="9"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource Brush.Mist}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <Border Grid.Column="5" Style="{StaticResource TransportPill}">
                                                <TextBlock Style="{StaticResource TransportText}">
                                                    <Run Text="{Binding Transport, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Connections}" Width="34" TextAlignment="Right" Margin="0,0,8,0"
                                                           FontFamily="{StaticResource Font.Data}" FontSize="11.5"
                                                           Foreground="{StaticResource Brush.Mist}"/>
                                                <ProgressBar Style="{StaticResource BarFill}" Width="46" Value="{Binding Share, Mode=OneWay}"/>
                                            </StackPanel>
                                            <Border Grid.Column="7" Background="{StaticResource Brush.WatchDim}" BorderBrush="#4DF2B33D"
                                                    BorderThickness="1" CornerRadius="10" Padding="7,1.5" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Beaconing, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="9"
                                                               Foreground="{StaticResource Brush.Watch}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="beacon" Style="{StaticResource Pill.Text}" FontSize="9"
                                                               Foreground="{StaticResource Brush.Watch}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EndpointCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource IconWell}" Width="40" Height="40" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15"
                                       HorizontalAlignment="Center" Foreground="{StaticResource Brush.Faint}"/>
                        </Border>
                        <TextBlock Text="Nothing observed yet" Style="{StaticResource Text.Body}" FontWeight="Medium"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasNoMatchingSurface, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No endpoints match the current filter" Style="{StaticResource Text.Body}" FontWeight="Medium"
                                   HorizontalAlignment="Center"/>
                        <Button Content="Reset filter" Style="{StaticResource Btn.Subtle}" Margin="0,10,0,0"
                                HorizontalAlignment="Center" Command="{Binding ResetSurfaceFilterCommand}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
