<UserControl x:Class="BruceEDR.Gui.Views.MapKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <!-- The key under a map: what each colour means, and how to move around. Its own strip, so it never covers the map. -->
    <Border Padding="16,8" Background="#F00B0E18" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding Items, ElementName=Self}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Faint}" FontSize="11"
                       TextAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0"
                       Text="Scroll to zoom, drag to move&#10;Double-click folds, F shows it all"/>
        </Grid>
    </Border>
</UserControl>
