<UserControl x:Class="BruceEDR.Gui.Views.CoverageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:BruceEDR.Gui.Views"
             Style="{StaticResource View.Root}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedTechniques" Source="{Binding Techniques}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Tactic"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="TechniqueDot" TargetType="Border">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="CornerRadius" Value="3.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TechniqueRowBg" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.ThreatDim}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented toggle: the active segment is filled -->
        <Style x:Key="Segment" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Command" Value="{Binding SetCoverageModeCommand}"/>
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Padding" Value="11,5"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ChipSelected}">
                            <Binding Path="CoverageMode"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource Brush.AccentDim}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One technique cell of the matrix; click opens the MITRE page -->
        <Style x:Key="MatrixCell" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="base" CornerRadius="4" BorderThickness="1"
                                    Background="{StaticResource Brush.InkRaised}" BorderBrush="{StaticResource Brush.LineSoft}"/>
                            <Border x:Name="tint" CornerRadius="4" Background="{StaticResource Brush.Accent}" Opacity="0"/>
                            <StackPanel Margin="6,4">
                                <TextBlock x:Name="id" Text="{Binding Id}" FontFamily="{StaticResource Font.Data}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Faint}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="name" Text="{Binding ShortName}" FontSize="9.5" Margin="0,1,0,0"
                                           Foreground="{StaticResource Brush.Faint}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="covered">
                                <Setter TargetName="tint" Property="Opacity" Value="{Binding Strength}"/>
                                <Setter TargetName="base" Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
                                <Setter TargetName="id" Property="Foreground" Value="{StaticResource Brush.Paper}"/>
                                <Setter TargetName="name" Property="Foreground" Value="{StaticResource Brush.Paper}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="observed">
                                <Setter TargetName="base" Property="Background" Value="{StaticResource Brush.Threat}"/>
                                <Setter TargetName="base" Property="BorderBrush" Value="{StaticResource Brush.Threat}"/>
                                <Setter TargetName="id" Property="Foreground" Value="{StaticResource Brush.OnAccent}"/>
                                <Setter TargetName="name" Property="Foreground" Value="{StaticResource Brush.OnAccent}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="base" Property="BorderBrush" Value="{StaticResource Brush.Paper}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,5,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Detection coverage" Style="{StaticResource Text.Display}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Segment}" Tag="matrix" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Matrix"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Segment}" Tag="list">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="List"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,7,0">
                <StackPanel Orientation="Horizontal">
                    <v:ScoreRing Width="64" Height="64" Value="{Binding CoveragePercentRounded}" Severity="accent"
                                 Caption="%" ShowTicks="False"/>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,6,0">
                        <TextBlock Text="CATALOGUE" Style="{StaticResource Text.Label}"/>
                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Data}" FontSize="12"
                                   Foreground="{StaticResource Brush.Mist}">
                            <Run Text="{Binding CoveredTechniqueCount, Mode=OneWay}" Foreground="{StaticResource Brush.Paper}"/>
                            <Run Text="of"/>
                            <Run Text="{Binding CatalogTechniqueCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,13" Margin="7,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="DETECTION RULES" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis" ToolTip="Detection rules"/>
                        <TextBlock Text="{Binding RuleCount}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right"
                            Background="{StaticResource Brush.AccentDim}" BorderBrush="{StaticResource Brush.AccentLine}">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Accent}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,13" Margin="7,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TECHNIQUES COVERED" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis" ToolTip="Techniques covered"/>
                        <TextBlock Text="{Binding CoveredTechniqueCount}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right"
                            Background="{StaticResource Brush.SafeDim}" BorderBrush="#4D34D399">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Safe}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,13" Margin="7,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ACTIVE ON THIS HOST" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis" ToolTip="Active on this host"/>
                        <TextBlock Text="{Binding ObservedTechniqueCount}" Style="{StaticResource TileValue}"
                                   Foreground="{StaticResource Brush.Threat}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right"
                            Background="{StaticResource Brush.ThreatDim}" BorderBrush="#4DF2555A">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Threat}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,13" Margin="7,0,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="INDICATORS" Style="{StaticResource Text.Label}" Margin="0,0,36,0" TextTrimming="CharacterEllipsis" ToolTip="Indicators"/>
                        <TextBlock Text="{Binding IndicatorCount}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Mist}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Matrix -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsMatrixMode, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource LegendSwatch}" Margin="0,0,5,0" Background="{StaticResource Brush.Threat}"
                                BorderBrush="{StaticResource Brush.Threat}"/>
                        <TextBlock Text="seen on this host" Style="{StaticResource Text.Label}" FontWeight="Medium"/>
                        <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource Brush.Accent}"
                                BorderBrush="{StaticResource Brush.AccentLine}"/>
                        <TextBlock Text="covered (stronger with more rules)" Style="{StaticResource Text.Label}" FontWeight="Medium"/>
                        <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource Brush.InkRaised}"
                                BorderBrush="{StaticResource Brush.Line}"/>
                        <TextBlock Text="no rule" Style="{StaticResource Text.Label}" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,10,10,6">
                    <ItemsControl ItemsSource="{Binding TacticColumns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,0">
                                    <Border Padding="6,0,6,8" Height="58">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" ToolTip="{Binding Name}"
                                                       Foreground="{StaticResource Brush.Paper}" TextWrapping="WrapWithOverflow"
                                                       MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource Font.Data}" FontSize="9.5"
                                                           Foreground="{StaticResource Brush.Faint}"/>
                                            </Grid>
                                            <ProgressBar Style="{StaticResource Meter}" Height="3" Margin="0,4,0,0"
                                                         Value="{Binding Percent, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MatrixCell}" ToolTip="{Binding Tooltip}"
                                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Url}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- List -->
        <Border Grid.Row="2" Padding="4">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMatrixMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedTechniques}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,14,12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" FontSize="12.5"/>
                                            <TextBlock Text="{Binding Items, Converter={StaticResource TacticSummary}}"
                                                       FontSize="10.5" Foreground="{StaticResource Brush.Faint}"
                                                       VerticalAlignment="Center" Margin="10,1,0,0"/>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" VerticalAlignment="Center"
                                                     Value="{Binding Items, Converter={StaticResource TacticProgress}, Mode=OneWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,7" Margin="2,1" CornerRadius="4" Style="{StaticResource TechniqueRowBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource TechniqueDot}" Margin="2,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Data}" FontSize="11"
                                               FontWeight="Medium" Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               FontSize="{StaticResource Size.Body}" Foreground="{StaticResource Brush.Paper}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Faint}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="4" Content="&#xE8A7;" Style="{StaticResource Btn.Icon}" Width="26" Height="24"
                                            FontSize="10" ToolTip="Open the MITRE ATT&amp;CK page"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Url}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
