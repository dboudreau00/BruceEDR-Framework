<UserControl x:Class="ProcessShield.Gui.Views.CoverageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Tactic-grouped view over the flat technique list. Grouping happens here in
             the view: the VM keeps one flat, ordered collection. -->
        <CollectionViewSource x:Key="GroupedTechniques" Source="{Binding Techniques}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Tactic"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="TechniqueDot" TargetType="Border">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="CornerRadius" Value="3.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "Active on this host" rows get a violet id and a tinted row -->
        <Style x:Key="TechniqueRowBg" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.ThreatDim}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Detection coverage" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="MITRE ATT&amp;CK techniques the loaded rules can detect, grouped by tactic, with what this host has actually exhibited"
                       Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                       Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style x:Key="Tile" TargetType="StackPanel">
                    <Setter Property="Margin" Value="15,13"/>
                </Style>
                <Style x:Key="TileValue" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
                    <Setter Property="FontSize" Value="26"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
                    <Setter Property="Margin" Value="0,6,0,0"/>
                </Style>
            </Grid.Resources>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,6,0">
                <StackPanel Style="{StaticResource Tile}">
                    <TextBlock Text="DETECTION RULES" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding RuleCount}" Style="{StaticResource TileValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="6,0,6,0">
                <StackPanel Style="{StaticResource Tile}">
                    <TextBlock Text="TECHNIQUES COVERED" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding CoveredTechniqueCount}" Style="{StaticResource TileValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="6,0,6,0">
                <StackPanel Style="{StaticResource Tile}">
                    <TextBlock Text="ACTIVE ON THIS HOST" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding ObservedTechniqueCount}" Style="{StaticResource TileValue}"
                               Foreground="{StaticResource Brush.Threat}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="0" Margin="6,0,0,0">
                <StackPanel Style="{StaticResource Tile}">
                    <TextBlock Text="INDICATORS LOADED" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding IndicatorCount}" Style="{StaticResource TileValue}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedTechniques}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <!-- Tactic section header: name, coverage summary, progress bar -->
                                    <Grid Margin="10,14,12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}"
                                                       FontSize="12.5"/>
                                            <TextBlock Text="{Binding Items, Converter={StaticResource TacticSummary}}"
                                                       FontSize="10.5" Foreground="{StaticResource Brush.Faint}"
                                                       VerticalAlignment="Center" Margin="10,1,0,0"/>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1" Style="{StaticResource Meter}"
                                                     VerticalAlignment="Center"
                                                     Value="{Binding Items, Converter={StaticResource TacticProgress}, Mode=OneWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,7" Margin="2,1" CornerRadius="4"
                                    Style="{StaticResource TechniqueRowBg}"
                                    ToolTip="{Binding Url}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource TechniqueDot}" Margin="2,0,12,0"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Data}" FontSize="11"
                                               FontWeight="Medium" Foreground="{StaticResource Brush.Accent}"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               FontSize="{StaticResource Size.Body}"
                                               Foreground="{StaticResource Brush.Paper}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Faint}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- MITRE reference opens in the browser -->
                                    <Button Grid.Column="4" Content="open" Padding="8,2"
                                            Style="{StaticResource Chip}" FontSize="10"
                                            ToolTip="Open the MITRE ATT&amp;CK page for this technique"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Url}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
