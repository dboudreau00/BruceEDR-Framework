<UserControl x:Class="ProcessShield.Gui.Views.CoverageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="TechniqueDot" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Detection coverage" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="MITRE ATT&amp;CK techniques the loaded rules can detect, and which of them this host has actually exhibited"
                       Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                       Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="DETECTION RULES" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding RuleCount}" Style="{StaticResource Text.Display}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,7,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="TECHNIQUES COVERED" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding CoveredTechniqueCount}" Style="{StaticResource Text.Display}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="INDICATORS LOADED" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding IndicatorCount}" Style="{StaticResource Text.Display}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Techniques}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8" Margin="2,1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource TechniqueDot}" Margin="2,0,12,0"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Data}" FontSize="12"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="3" Text="{Binding Tactic}" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Mist}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="4" Text="{Binding Status}" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Faint}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
