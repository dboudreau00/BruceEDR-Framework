<UserControl x:Class="ProcessShield.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Cell.Data" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="FontSize" Value="{StaticResource Size.Data}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Mist}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Cell.Faint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Severity-coloured brush swaps used across the ribbon, badges and meters -->
        <Style x:Key="StatDot" TargetType="Border">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="CornerRadius" Value="4.5"/>
            <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLevel}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLevel}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 3px severity rail on the posture ribbon -->
        <Style x:Key="RibbonRail" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLevel}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLevel}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- State badge: dim fill + state-coloured text, driven by the row's Severity -->
        <Style x:Key="RowBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="{StaticResource Brush.WatchDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.ThreatDim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Background" Value="{StaticResource Brush.SafeDim}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowBadgeText" TargetType="TextBlock" BasedOn="{StaticResource Badge.Text}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Score text + meter colour by severity -->
        <Style x:Key="ScoreText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="FontSize" Value="{StaticResource Size.Data}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScoreMeter" TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Problem banner (visible only when the engine can't run) -->
        <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="8" Padding="14,11"
                Background="{StaticResource Brush.ThreatDim}"
                BorderBrush="{StaticResource Brush.Threat}" BorderThickness="1"
                Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,12,0"
                        Background="{StaticResource Brush.Threat}"/>
                <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Paper}"/>
            </StackPanel>
        </Border>

        <!-- Posture ribbon with a severity rail -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" CornerRadius="2,0,0,2" Style="{StaticResource RibbonRail}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,18">
                    <Grid VerticalAlignment="Center" Margin="0,0,14,0">
                        <!-- Pulsing halo behind the state dot while monitoring -->
                        <Ellipse x:Name="halo" Width="9" Height="9" Fill="Transparent"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Safe}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="pulse">
                                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:2.4">
                                                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="1" To="2.6" Duration="0:0:2.4"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="1" To="2.6" Duration="0:0:2.4"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.55" To="0" Duration="0:0:2.4"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="pulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Border Style="{StaticResource StatDot}"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Display}"/>
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}" Margin="0,4,0,0">
                            <Run Text="Monitors:"/>
                            <Run Text="{Binding Monitors, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding LastMessage}" VerticalAlignment="Center"
                           Margin="0,0,20,0" MaxWidth="360" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LastMessage}"
                           FontFamily="{StaticResource Font.Data}" FontSize="11"
                           Foreground="{StaticResource Brush.Faint}"/>
            </Grid>
        </Border>

        <!-- Stat cards, each with its 3px severity rail -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style x:Key="StatValue" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
                    <Setter Property="FontSize" Value="26"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Margin" Value="0,6,0,0"/>
                </Style>
            </Grid.Resources>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="2,0,0,2" Background="{StaticResource Brush.Threat}"/>
                    <StackPanel Grid.Column="1" Margin="15,13">
                        <TextBlock Text="CONTAINED" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="{Binding ContainedCount}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Threat}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="6,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="2,0,0,2" Background="{StaticResource Brush.Watch}"/>
                    <StackPanel Grid.Column="1" Margin="15,13">
                        <TextBlock Text="FLAGGED" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="{Binding FlaggedCount}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Watch}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="6,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="2,0,0,2" Background="{StaticResource Brush.Info}"/>
                    <StackPanel Grid.Column="1" Margin="15,13">
                        <TextBlock Text="EVENTS" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="{Binding Events.Count}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Paper}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="0" Margin="6,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="2,0,0,2" Background="{StaticResource Brush.Watch}"/>
                    <StackPanel Grid.Column="1" Margin="15,13">
                        <TextBlock Text="BEACONING" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="{Binding BeaconCount}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Paper}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Threats table + details/actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,13,16,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Process verdicts" Style="{StaticResource Text.Title}"/>
                            <TextBlock Text="Contained and flagged processes, live" Margin="0,2,0,0"
                                       FontSize="10.5" Foreground="{StaticResource Brush.Faint}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource Input.Search}"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 ToolTip="Filter by process, pid, path or state"
                                 Text="{Binding ThreatSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="Refresh" VerticalAlignment="Center" Padding="12,5"
                                Style="{StaticResource Btn.Subtle}" Command="{Binding RefreshCommand}"
                                ToolTip="Refresh now (F5)"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.LineSoft}"/>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Threats}"
                                  SelectedItem="{Binding SelectedThreat, Mode=TwoWay}"
                                  Style="{StaticResource Grid.Base}" Margin="4,2,4,4">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy incident report" Command="{Binding CopyReportCommand}"/>
                                    <MenuItem Header="Copy image path" Command="{Binding CopyPathCommand}"/>
                                    <MenuItem Header="Open file location" Command="{Binding OpenLocationCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="12">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="3" CornerRadius="2" Margin="4,4" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="threat">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="safe">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"
                                                    ElementStyle="{StaticResource Cell.Data}"/>
                                <DataGridTemplateColumn Header="PROCESS" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                           FontSize="{StaticResource Size.Body}"
                                                           Foreground="{StaticResource Brush.Paper}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ImagePath}" Margin="0,1,0,0"
                                                           FontFamily="{StaticResource Font.Data}" FontSize="10"
                                                           Foreground="{StaticResource Brush.Faint}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ImagePath}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SCORE" Width="118" SortMemberPath="Score">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Score}" Style="{StaticResource ScoreText}"
                                                           Width="26"/>
                                                <ProgressBar Style="{StaticResource ScoreMeter}" Width="52"
                                                             Value="{Binding Score, Mode=OneWay}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="STATE" Width="112" SortMemberPath="State">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RowBadge}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="4" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                            Margin="0,0,6,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="threat">
                                                                        <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="safe">
                                                                        <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding State}" Style="{StaticResource RowBadgeText}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TRUST" Binding="{Binding Trust}" Width="78"
                                                    ElementStyle="{StaticResource Cell.Faint}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Designed empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Threats.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Center"
                                    Background="{StaticResource Brush.InkRaised}"
                                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Brush.Faint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nothing flagged" Style="{StaticResource Text.Body}" FontWeight="Medium"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="ProcessShield is watching. Verdicts land here the moment a process misbehaves."
                                       FontSize="11.5" Foreground="{StaticResource Brush.Faint}" TextWrapping="Wrap"
                                       MaxWidth="300" TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Details / actions -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Center"
                                Background="{StaticResource Brush.InkRaised}"
                                BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Brush.Faint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No process selected" Style="{StaticResource Text.Body}" FontWeight="Medium"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Select a row to see why it flagged, its ATT&amp;CK techniques, and take action."
                                   FontSize="11.5" Foreground="{StaticResource Brush.Faint}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Detail -->
                    <!-- DataContext is the selected row, so Visibility must bind HasSelection
                         against the MainViewModel explicitly (via the UserControl), or it would
                         resolve against the row (no such property) and the panel never hides. -->
                    <DockPanel Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                               DataContext="{Binding SelectedThreat}">

                        <!-- Header -->
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.LineSoft}"
                                BorderThickness="0,0,0,1" Padding="16,13">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}"
                                                   MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Data}" FontSize="10.5"
                                                   Foreground="{StaticResource Brush.Faint}">
                                            <Run Text="PID"/> <Run Text="{Binding Pid, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Style="{StaticResource RowBadge}" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding State}" Style="{StaticResource RowBadgeText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding ImagePath}" Margin="0,7,0,0"
                                           FontFamily="{StaticResource Font.Data}" FontSize="10.5"
                                           Foreground="{StaticResource Brush.Faint}" TextWrapping="Wrap"
                                           ToolTip="{Binding ImagePath}"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions pinned to the bottom -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.LineSoft}"
                                BorderThickness="0,1,0,0" Padding="16,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Release" Style="{StaticResource Btn.Primary}"
                                            ToolTip="Resume the process and remove its firewall block"
                                            Command="{Binding DataContext.ReleaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Grid.Column="2" Content="Suspend" Style="{StaticResource Btn.Subtle}"
                                            Command="{Binding DataContext.SuspendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                                <Button Content="End process" Style="{StaticResource Btn.Danger}" Margin="0,8,0,0"
                                        Command="{Binding DataContext.EndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Copy report" Style="{StaticResource Btn.Subtle}"
                                            ToolTip="Copy a plain-text incident report to the clipboard"
                                            Command="{Binding DataContext.CopyReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Grid.Column="2" Content="Open location" Style="{StaticResource Btn.Subtle}"
                                            ToolTip="Reveal the image in File Explorer"
                                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Scrolling body -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,12,16,12">
                                <!-- Fact grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="RISK SCORE" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Style="{StaticResource Text.Data}">
                                            <Run Text="{Binding Score, Mode=OneWay}"/><Run Text=" / 100" Foreground="{StaticResource Brush.Faint}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="PEAK" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Text="{Binding PeakScore}" Style="{StaticResource Text.Data}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="FIRST SEEN" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Text="{Binding FirstSeen}" Style="{StaticResource Text.Data}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="TRUST" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Text="{Binding Trust}" Style="{StaticResource Text.Data}"
                                                   Foreground="{StaticResource Brush.Mist}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Ancestry -->
                                <StackPanel Visibility="{Binding HasAncestry, Converter={StaticResource BoolToVis}}"
                                            Margin="0,12,0,0">
                                    <TextBlock Text="ANCESTRY" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Text="{Binding Ancestry}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource Font.Data}" FontSize="11"
                                               Foreground="{StaticResource Brush.Mist}"/>
                                </StackPanel>

                                <!-- Command line well -->
                                <StackPanel Visibility="{Binding HasCommandLine, Converter={StaticResource BoolToVis}}"
                                            Margin="0,12,0,0">
                                    <TextBlock Text="COMMAND LINE" Style="{StaticResource DetailLabel}"/>
                                    <Border Background="{StaticResource Brush.InkRaised}"
                                            BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="1"
                                            CornerRadius="4" Padding="10,8">
                                        <TextBlock Text="{Binding CommandLine}" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource Font.Data}" FontSize="10.5"
                                                   Foreground="{StaticResource Brush.Mist}"/>
                                    </Border>
                                </StackPanel>

                                <!-- ATT&CK technique chips -->
                                <StackPanel Visibility="{Binding HasTechniques, Converter={StaticResource BoolToVis}}"
                                            Margin="0,12,0,0">
                                    <TextBlock Text="MITRE ATT&amp;CK" Style="{StaticResource DetailLabel}"/>
                                    <ItemsControl ItemsSource="{Binding Techniques}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TechChip}">
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Data}"
                                                               FontSize="10.5" FontWeight="Medium"
                                                               Foreground="{StaticResource Brush.Accent}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Why it flagged -->
                                <TextBlock Text="WHY IT FLAGGED" Style="{StaticResource DetailLabel}" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding Reasons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="6" Height="6" CornerRadius="3" Margin="1,5,9,0"
                                                        VerticalAlignment="Top"
                                                        Background="{StaticResource Brush.Watch}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                           FontSize="11.5" Foreground="{StaticResource Brush.Mist}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
