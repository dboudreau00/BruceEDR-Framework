<UserControl x:Class="ProcessShield.Gui.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Coloured severity dot for a feed row -->
        <Style x:Key="EventDot" TargetType="Border">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="CornerRadius" Value="3.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="QUARANTINE">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ACTION">
                    <Setter Property="Background" Value="{StaticResource Brush.Info}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Filter chip: quiet by default, violet-tinted when it is the active filter.
             The chip's Tag carries its filter key; selection is EventFilter == Tag. -->
        <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Command" Value="{Binding SetEventFilterCommand}"/>
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ChipSelected}">
                            <Binding Path="EventFilter"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource Brush.AccentDim}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipCount" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Live events" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="Warnings, containments, and analyst actions as they happen"
                           Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{Binding PauseLabel}" Style="{StaticResource Btn.Subtle}"
                        ToolTip="Hold the feed to read; buffered events flush on resume"
                        Command="{Binding TogglePauseCommand}" MinWidth="86"/>
                <Button Content="Export" Style="{StaticResource Btn.Subtle}" Margin="8,0,0,0"
                        ToolTip="Save the filtered feed as CSV or JSON"
                        Command="{Binding ExportEventsCommand}"/>
                <Button Content="Clear" Style="{StaticResource Btn.Subtle}" Margin="8,0,0,0"
                        Command="{Binding ClearEventsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Search + severity chips -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource Input.Search}"
                     ToolTip="Filter by process, message, rule id or technique"
                     Text="{Binding EventSearch, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource FilterChip}" Tag="ALL">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All"/>
                        <TextBlock Text="{Binding CountAll}" Style="{StaticResource ChipCount}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FilterChip}" Tag="QUARANTINE">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Quarantine"/>
                        <TextBlock Text="{Binding CountQuarantine}" Style="{StaticResource ChipCount}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FilterChip}" Tag="WARN">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Warn"/>
                        <TextBlock Text="{Binding CountWarn}" Style="{StaticResource ChipCount}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FilterChip}" Tag="ACTION">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Action"/>
                        <TextBlock Text="{Binding CountAction}" Style="{StaticResource ChipCount}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FilterChip}" Tag="INFO">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Info"/>
                        <TextBlock Text="{Binding CountInfo}" Style="{StaticResource ChipCount}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FilterChip}" Tag="ERROR">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Error"/>
                        <TextBlock Text="{Binding CountError}" Style="{StaticResource ChipCount}"/>
                    </StackPanel>
                </Button>

                <!-- Paused indicator -->
                <Border Background="{StaticResource Brush.WatchDim}" BorderBrush="#4DF2B33D" BorderThickness="1"
                        CornerRadius="4" Padding="8,3" Margin="6,0,0,0"
                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="FEED PAUSED" Style="{StaticResource Text.Label}"
                               Foreground="{StaticResource Brush.Watch}"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" Margin="2,1" CornerRadius="4"
                                        Background="Transparent" ToolTip="{Binding Tooltip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy line"
                                                      Command="{Binding PlacementTarget.Tag.CopyEventCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </Border.Tag>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource EventDot}" Margin="2,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Time}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Data}" FontSize="11"
                                                   Foreground="{StaticResource Brush.Faint}" Margin="0,0,14,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Level}" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Label}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Text}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Paper}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Designed empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Events.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Center"
                            Background="{StaticResource Brush.InkRaised}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource Brush.Faint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No events yet" Style="{StaticResource Text.Body}" FontWeight="Medium"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Detections, containments and analyst actions stream in here in real time."
                               FontSize="11.5" Foreground="{StaticResource Brush.Faint}" TextWrapping="Wrap"
                               MaxWidth="300" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
