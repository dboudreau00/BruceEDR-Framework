<UserControl x:Class="ProcessShield.Gui.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ProcessShield.Gui.Views"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Transport pill: TLS reads calm, plaintext HTTP is called out. -->
        <Style x:Key="TransportPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
            <Setter Property="Padding" Value="6,1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.InkRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTls}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SafeDim}"/>
                    <Setter Property="BorderBrush" Value="#4D34D399"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaintext}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.WatchDim}"/>
                    <Setter Property="BorderBrush" Value="#4DF2B33D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TransportText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTls}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaintext}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MapRowDot" TargetType="Border">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="CornerRadius" Value="3.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Network map" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="Where the processes on this host are talking to. Hover a marker or a row to link the two."
                       Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                       Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Map -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DockPanel>
                    <!-- Legend + counts -->
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.LineSoft}"
                            BorderThickness="0,0,0,1" Padding="16,11">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="COUNTRIES" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="{Binding MappedCount}" Style="{StaticResource Metric.Value}"/>
                                <Border Style="{StaticResource Metric.Sep}"/>
                                <TextBlock Text="ENDPOINTS" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="{Binding EndpointCount}" Style="{StaticResource Metric.Value}"/>
                                <Border Style="{StaticResource Metric.Sep}"/>
                                <TextBlock Text="BEACONING" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="{Binding BeaconCount}" Style="{StaticResource Metric.Value}"
                                           Foreground="{StaticResource Brush.Watch}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Safe}" VerticalAlignment="Center"/>
                                <TextBlock Text="ok" Style="{StaticResource Text.Label}" Margin="5,0,12,0"/>
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Watch}" VerticalAlignment="Center"/>
                                <TextBlock Text="watch" Style="{StaticResource Text.Label}" Margin="5,0,12,0"/>
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Threat}" VerticalAlignment="Center"/>
                                <TextBlock Text="threat" Style="{StaticResource Text.Label}" Margin="5,0,12,0"/>
                                <Ellipse Width="8" Height="8" Stroke="{StaticResource Brush.Watch}" StrokeThickness="1"
                                         StrokeDashArray="2 2" Fill="Transparent" VerticalAlignment="Center"/>
                                <TextBlock Text="has plaintext http" Style="{StaticResource Text.Label}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Honest caveat strip: the map is allocation geography, not packet geography -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.LineSoft}"
                            BorderThickness="0,1,0,0" Padding="16,8">
                        <TextBlock TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="{StaticResource Brush.Faint}"
                                   Text="Markers show where each address block is REGISTERED (offline RIR data, /16 resolution) — not where the host is. CDNs and anycast land in the wrong place. Never attribute from this alone."/>
                    </Border>

                    <Grid>
                        <v:WorldMapCanvas x:Name="Map"
                                          World="{Binding World}"
                                          Markers="{Binding Markers}"/>

                        <!-- Empty / degraded states -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Markers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Center"
                                    Background="{StaticResource Brush.InkRaised}"
                                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Brush.Faint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nothing plotted yet" Style="{StaticResource Text.Body}" FontWeight="Medium"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.Faint}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,4,0,0"
                                       Text="Outbound connections appear here once the network monitor sees traffic to a routable address."/>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.Watch}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding GeoMissing, Converter={StaticResource BoolToVis}}"
                                       Text="The offline geo table is missing from intel\geo, so nothing can be placed. Run tools/build-geo.py to regenerate it."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Side list -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.LineSoft}"
                            BorderThickness="0,0,0,1" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="Destinations" Style="{StaticResource Text.Title}"/>
                            <TextBlock Text="Grouped by country, worst first" Margin="0,2,0,0"
                                       FontSize="10.5" Foreground="{StaticResource Brush.Faint}"/>
                        </StackPanel>
                    </Border>

                    <!-- Unplaced tray: never silently drop traffic off the picture -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.LineSoft}"
                            BorderThickness="0,1,0,0" Padding="16,10"
                            Visibility="{Binding Unplaced.HasAny, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="NOT ON THE MAP" Style="{StaticResource Text.Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding Unplaced.LocalCount}" Style="{StaticResource Text.Data}"/>
                                <TextBlock Text="local network" Style="{StaticResource Text.Body}"
                                           Foreground="{StaticResource Brush.Mist}" Margin="6,0,14,0"/>
                                <TextBlock Text="{Binding Unplaced.UnknownCount}" Style="{StaticResource Text.Data}"/>
                                <TextBlock Text="unplaced (IPv6 / unallocated)" Style="{StaticResource Text.Body}"
                                           Foreground="{StaticResource Brush.Mist}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Markers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row" Padding="14,10" Margin="4,2" CornerRadius="6"
                                            Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                            MouseEnter="Marker_MouseEnter" MouseLeave="Marker_MouseLeave">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource MapRowDot}" Margin="0,0,9,0"/>
                                                    <TextBlock Text="{Binding Country}" FontWeight="Medium"
                                                               FontSize="{StaticResource Size.Body}"
                                                               Foreground="{StaticResource Brush.Paper}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    <TextBlock Text="{Binding CountryCode}" Margin="7,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Font.Data}" FontSize="9.5"
                                                               Foreground="{StaticResource Brush.Faint}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Connections}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource Font.Data}" FontSize="11.5"
                                                           Foreground="{StaticResource Brush.Mist}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Summary}" Margin="16,3,0,0"
                                                       FontSize="10.5" Foreground="{StaticResource Brush.Faint}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Endpoints inside this country, revealed while hovered -->
                                            <ItemsControl ItemsSource="{Binding Endpoints}" Margin="16,7,0,0"
                                                          Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource TransportPill}"
                                                                    Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Transport}"
                                                                           Style="{StaticResource TransportText}"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Endpoint}"
                                                                           FontFamily="{StaticResource Font.Data}"
                                                                           FontSize="10.5"
                                                                           Foreground="{StaticResource Brush.Mist}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Process}" FontSize="10"
                                                                           Foreground="{StaticResource Brush.Faint}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                                            <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Brush.AccentLine}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
