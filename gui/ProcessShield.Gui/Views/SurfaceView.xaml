<UserControl x:Class="ProcessShield.Gui.Views.SurfaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Row signal dot, coloured by the row's Severity string, matching the threat table. -->
        <Style x:Key="SurfaceDot" TargetType="Border">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="CornerRadius" Value="3.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "beaconing" cadence pill -->
        <Style x:Key="CadenceText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Beaconing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Watch}"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="API surface" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="Every endpoint a process on this machine was observed connecting to, correlated with the DNS names it resolved"
                           Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                           Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Content="Export" Style="{StaticResource Btn.Subtle}" Margin="8,0,0,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="Save the filtered endpoint list as CSV"
                    Command="{Binding ExportSurfaceCommand}"/>
        </Grid>

        <!-- Summary tiles -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="2,0,0,2" Background="{StaticResource Brush.Info}"/>
                    <StackPanel Grid.Column="1" Margin="15,13">
                        <TextBlock Text="ENDPOINTS OBSERVED" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="{Binding EndpointCount}" FontFamily="{StaticResource Font.Data}"
                                   FontSize="26" FontWeight="Medium" Foreground="{StaticResource Brush.Paper}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="6,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="2,0,0,2" Background="{StaticResource Brush.Watch}"/>
                    <StackPanel Grid.Column="1" Margin="15,13">
                        <TextBlock Text="BEACONING" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="{Binding BeaconCount}" FontFamily="{StaticResource Font.Data}"
                                   FontSize="26" FontWeight="Medium" Foreground="{StaticResource Brush.Watch}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Search + beaconing filter -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource Input.Search}"
                     ToolTip="Filter by endpoint, host or process"
                     Text="{Binding SurfaceSearch, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding OnlyBeaconing}"/>
                <TextBlock Text="Only beaconing" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Mist}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <!-- Designed empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EndpointCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Center"
                            Background="{StaticResource Brush.InkRaised}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource Brush.Faint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nothing observed yet" Style="{StaticResource Text.Body}" FontWeight="Medium"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="The network and DNS monitors need Administrator rights and some traffic."
                               FontSize="11.5" Foreground="{StaticResource Brush.Faint}" TextWrapping="Wrap"
                               MaxWidth="320" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Surface}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" Margin="2,1" CornerRadius="4" Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="92"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource SurfaceDot}" Margin="2,0,12,0"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Pid}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Data}" FontSize="11"
                                                   Foreground="{StaticResource Brush.Faint}"/>

                                        <TextBlock Grid.Column="2" Text="{Binding Process}" VerticalAlignment="Center"
                                                   FontSize="{StaticResource Size.Body}"
                                                   Foreground="{StaticResource Brush.Paper}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{StaticResource Font.Data}" FontSize="11.5"
                                                       Foreground="{StaticResource Brush.Paper}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="10"
                                                       FontFamily="{StaticResource Font.Data}"
                                                       Foreground="{StaticResource Brush.Faint}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="4" Text="{Binding Scheme}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Mist}" FontSize="11.5"/>

                                        <TextBlock Grid.Column="5" Text="{Binding Connections}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Data}" FontSize="11.5"
                                                   Foreground="{StaticResource Brush.Mist}"
                                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>

                                        <TextBlock Grid.Column="6" Text="{Binding Cadence}" Style="{StaticResource CadenceText}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
