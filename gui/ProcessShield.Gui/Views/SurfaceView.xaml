<UserControl x:Class="ProcessShield.Gui.Views.SurfaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Row signal dot, coloured by the row's Severity string, matching the threat table. -->
        <Style x:Key="SurfaceDot" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="threat">
                    <Setter Property="Background" Value="{StaticResource Brush.Threat}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="watch">
                    <Setter Property="Background" Value="{StaticResource Brush.Watch}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="safe">
                    <Setter Property="Background" Value="{StaticResource Brush.Safe}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="API surface" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="Every endpoint a process on this machine was observed connecting to, correlated with the DNS names it resolved"
                       Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                       Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Summary tiles -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="ENDPOINTS OBSERVED" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding EndpointCount}" Style="{StaticResource Text.Display}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="BEACONING" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding BeaconCount}" Style="{StaticResource Text.Display}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <TextBlock Text="Nothing observed yet. The network and DNS monitors need Administrator rights and some traffic."
                           Foreground="{StaticResource Brush.Faint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EndpointCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Surface}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9" Margin="2,1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="92"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource SurfaceDot}" Margin="2,0,12,0"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Pid}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Data}" FontSize="12"
                                                   Foreground="{StaticResource Brush.Faint}"/>

                                        <TextBlock Grid.Column="2" Text="{Binding Process}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{StaticResource Font.Data}" FontSize="12"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{StaticResource Brush.Faint}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="4" Text="{Binding Scheme}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Mist}" FontSize="12"/>

                                        <TextBlock Grid.Column="5" Text="{Binding Connections}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Data}" FontSize="12"
                                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>

                                        <TextBlock Grid.Column="6" Text="{Binding Cadence}" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource Brush.Mist}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
