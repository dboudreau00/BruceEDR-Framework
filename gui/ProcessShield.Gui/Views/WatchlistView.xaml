<UserControl x:Class="ProcessShield.Gui.Views.WatchlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Combo styled to match the dark inputs; the stock WPF one is bright grey. -->
        <Style x:Key="Picker" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
            <Setter Property="Background" Value="{StaticResource Brush.InkRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource Brush.InkRaised}"
                                                BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Control}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="9,5"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="9" Margin="0,0,9,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.Faint}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#313A4E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border Background="{StaticResource Brush.Panel}"
                                        BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Control}" Margin="0,3,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <StackPanel IsItemsHost="True" Margin="3"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Paper}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Watchlist" Style="{StaticResource Text.Display}"/>
                <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                           Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                           Text="Your own detections. Name a process, path, hash or command line and say what to do when it appears. Containment here overrides a trusted signature — that is the point."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                <TextBlock Text="Armed" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Column headings -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,9" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ON" Style="{StaticResource Text.Label}"/>
                <TextBlock Grid.Column="1" Text="MATCH" Style="{StaticResource Text.Label}"/>
                <TextBlock Grid.Column="2" Text="VALUE" Style="{StaticResource Text.Label}"/>
                <TextBlock Grid.Column="3" Text="ACTION" Style="{StaticResource Text.Label}"/>
                <TextBlock Grid.Column="4" Text="POINTS" Style="{StaticResource Text.Label}"/>
                <TextBlock Grid.Column="5" Text="NOTE" Style="{StaticResource Text.Label}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <!-- Designed empty state, with the two entries most people want first -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Center"
                            Background="{StaticResource Brush.InkRaised}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource Brush.Faint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No custom detections yet" Style="{StaticResource Text.Body}" FontWeight="Medium"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,4,0,0"
                               Text="Add the tools you have decided do not belong on this estate — a red-team binary by name, a hash from an incident report, or a command-line flag no legitimate app on your network uses."/>
                    <Button Content="Add an entry" Style="{StaticResource Btn.Primary}" Margin="0,14,0,0"
                            HorizontalAlignment="Center" Command="{Binding AddCommand}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="2,1" CornerRadius="6" Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.PanelHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="118"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton Grid.Column="0" Style="{StaticResource Switch}"
                                                          Width="28" Height="16" VerticalAlignment="Center"
                                                          IsChecked="{Binding Enabled}"/>

                                            <ComboBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource Picker}"
                                                      ItemContainerStyle="{StaticResource PickerItem}"
                                                      ItemsSource="{Binding DataContext.MatchKinds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Match, Mode=TwoWay}"/>

                                            <TextBox Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource Input}"
                                                     FontFamily="{StaticResource Font.Data}" FontSize="11.5"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                            <ComboBox Grid.Column="3" Margin="0,0,8,0" Style="{StaticResource Picker}"
                                                      ItemContainerStyle="{StaticResource PickerItem}"
                                                      ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Action, Mode=TwoWay}"/>

                                            <TextBox Grid.Column="4" Margin="0,0,8,0" Style="{StaticResource Input}"
                                                     FontFamily="{StaticResource Font.Data}"
                                                     Visibility="{Binding IsScoreAction, Converter={StaticResource BoolToVis}}"
                                                     Text="{Binding Score, Mode=TwoWay}"/>

                                            <TextBox Grid.Column="5" Margin="0,0,8,0" Style="{StaticResource Input}"
                                                     FontSize="11.5"
                                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                            <Button Grid.Column="6" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                    FontSize="11" Padding="0" Width="26" Height="26"
                                                    Style="{StaticResource Btn.Subtle}" ToolTip="Remove this entry"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Problem}" Margin="46,5,0,0" FontSize="11"
                                                   Foreground="{StaticResource Brush.Threat}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Warning}" Margin="46,5,0,0" FontSize="11"
                                                   Foreground="{StaticResource Brush.Watch}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Action bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Add entry" Style="{StaticResource Btn.Subtle}" Command="{Binding AddCommand}"/>
                <Button Content="Save &amp; arm" Style="{StaticResource Btn.Primary}" Margin="10,0,0,0"
                        Command="{Binding SaveCommand}"/>
                <Button Content="Reload from disk" Style="{StaticResource Btn.Subtle}" Margin="10,0,0,0"
                        Command="{Binding ReloadCommand}"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AlertOnEveryHit}"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Alert on every hit" Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Mist}" Margin="8,0,0,0" VerticalAlignment="Center"
                               ToolTip="Report a match even when the entry only adds points and the process never crosses a threshold."/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding Message}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Safe}"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
