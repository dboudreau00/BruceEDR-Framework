<UserControl x:Class="ProcessShield.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,20">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="Tune detection, trusted publishers, and where alerts are sent."
                       Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}" Margin="0,3,0,16"/>

            <!-- Detection -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Detection" Style="{StaticResource Text.Title}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,16">
                            <TextBlock Text="WARN AT SCORE" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Width="130" HorizontalAlignment="Left"
                                     Text="{Binding WarnThreshold}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,16">
                            <TextBlock Text="CONTAIN AT SCORE" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Width="130" HorizontalAlignment="Left"
                                     Text="{Binding QuarantineThreshold}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="TRUSTED-SIGNER DISCOUNT" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Width="130" HorizontalAlignment="Left"
                                     Text="{Binding TrustDiscount}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="CORRELATION WINDOW (SECONDS)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Width="130" HorizontalAlignment="Left"
                                     Text="{Binding CorrelationWindowSeconds}"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Brush.LineSoft}" Margin="0,16"/>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Automatically end confirmed threats" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="When off (recommended), contained processes are only suspended, so you can review and release false positives."
                                       Style="{StaticResource Caption}" MaxWidth="560" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding AutoKill}"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Use YARA memory scanning" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="Requires a YARA-enabled build; otherwise the builtin scanner is used."
                                       Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding UseYara}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Allowlist -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Trusted publishers" Style="{StaticResource Text.Title}" Margin="0,0,0,4"/>
                    <TextBlock Text="Signed software from these publishers is de-prioritised (e.g. your legitimate remote-support tools)."
                               Style="{StaticResource Caption}" Margin="0,0,0,14"/>

                    <TextBlock Text="PUBLISHER NAMES (ONE PER LINE)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}" Height="84" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Text="{Binding Publishers}"/>

                    <TextBlock Text="PINNED THUMBPRINTS (ONE SHA-1 PER LINE)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <TextBox Style="{StaticResource Input}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Text="{Binding Thumbprints}"/>

                    <Border Height="1" Background="{StaticResource Brush.LineSoft}" Margin="0,16"/>

                    <Grid>
                        <TextBlock Text="Require a valid signature chain" Style="{StaticResource Text.Body}"/>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding RequireValidChain}"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="Allow publisher-name match" Style="{StaticResource Text.Body}"/>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding AllowSubjectMatch}"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="Check certificate revocation" Style="{StaticResource Text.Body}"/>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding CheckRevocation}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Telemetry -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Alert forwarding" Style="{StaticResource Text.Title}" Margin="0,0,0,14"/>

                    <Grid>
                        <TextBlock Text="Send events to syslog" Style="{StaticResource Text.Body}"/>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding SyslogEnabled}"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="HOST" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding SyslogHost}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="PORT" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding SyslogPort}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <TextBlock Text="TCP" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Mist}"
                                       VerticalAlignment="Center" Margin="0,0,8,7"/>
                            <ToggleButton Style="{StaticResource Switch}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                          IsChecked="{Binding SyslogTcp}"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Brush.LineSoft}" Margin="0,16"/>

                    <Grid>
                        <TextBlock Text="Send events to a webhook (SIEM)" Style="{StaticResource Text.Body}"/>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding WebhookEnabled}"/>
                    </Grid>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="WEBHOOK URL" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding WebhookUrl}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kernel -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Kernel enforcement" Style="{StaticResource Text.Title}" Margin="0,0,0,14"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Block access via the minifilter driver" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="Only turn on with the signed ShieldFilter driver installed and a trusted-PID allowlist configured; otherwise it can block legitimate apps."
                                       Style="{StaticResource Caption}" MaxWidth="560" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding KernelBlocking}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Interface -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Interface" Style="{StaticResource Text.Title}" Margin="0,0,0,14"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Keep monitoring from the tray when minimized" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="Minimizing hides the window to the notification area; containments raise a balloon alert. Applies immediately."
                                       Style="{StaticResource Caption}" MaxWidth="560" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding MinimizeToTray}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Brush.LineSoft}" Margin="0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open app log" Style="{StaticResource Btn.Subtle}"
                                ToolTip="Reveal gui.log in File Explorer" Command="{Binding OpenLogCommand}"/>
                        <Button Content="Open config file" Style="{StaticResource Btn.Subtle}" Margin="10,0,0,0"
                                ToolTip="Reveal shield.config.json in File Explorer" Command="{Binding OpenConfigCommand}"/>
                    </StackPanel>
                    <TextBlock Text="Shortcuts: F5 refresh · Ctrl+1…5 switch views"
                               Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Save bar -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Save changes" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}"/>
                <Button Content="Reload from disk" Style="{StaticResource Btn.Subtle}" Margin="10,0,0,0" Command="{Binding ReloadCommand}"/>
                <TextBlock Text="{Binding SaveMessage}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Safe}"
                           TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
