<Window x:Class="ProcessShield.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ProcessShield.Gui.Views"
        Title="ProcessShield" Height="760" Width="1180"
        MinHeight="560" MinWidth="960"
        Icon="pack://application:,,,/Assets/shield.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Ink}"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <TabControl Style="{StaticResource Nav.Rail}">
        <TabItem Header="Dashboard" Style="{StaticResource Nav.Item}">
            <v:DashboardView/>
        </TabItem>
        <TabItem Header="Live events" Style="{StaticResource Nav.Item}">
            <v:EventsView/>
        </TabItem>
        <TabItem Header="API surface" Style="{StaticResource Nav.Item}">
            <v:SurfaceView/>
        </TabItem>
        <TabItem Header="Coverage" Style="{StaticResource Nav.Item}">
            <v:CoverageView/>
        </TabItem>
        <TabItem Header="Settings" Style="{StaticResource Nav.Item}">
            <v:SettingsView DataContext="{Binding Settings}"/>
        </TabItem>
    </TabControl>
</Window>
