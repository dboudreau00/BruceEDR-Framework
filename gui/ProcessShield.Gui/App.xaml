<Application x:Class="ProcessShield.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProcessShield.Gui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:EqualsConverter x:Key="Equals"/>
            <local:ChipSelectedConverter x:Key="ChipSelected"/>
            <local:TacticSummaryConverter x:Key="TacticSummary"/>
            <local:TacticProgressConverter x:Key="TacticProgress"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
