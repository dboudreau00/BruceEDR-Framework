{
  "detection": {
    "warnThreshold": 40,
    "quarantineThreshold": 70,
    "correlationWindowSeconds": 30,
    "autoKill": false,
    "trustDiscount": 30,
    "memoryScanEngine": "builtin",
    "yaraRulesPath": "rules",
    "kernelBlocking": false,

    "rulesPath": "rules/detection",
    "enableRuleEngine": true,

    "enableScoreDecay": true,
    "scoreDecayPoints": 5,
    "scoreDecayIntervalSeconds": 300,

    "enableBeaconDetection": true,
    "beaconMinConnections": 6,
    "beaconScore": 35,

    "enablePeAnalysis": true,
    "enableDomainAnalysis": true,
    "dgaScore": 25,

    "enableExtendedMonitors": true,
    "maxTrackedProcesses": 16384
  },
  "allowlist": {
    "publishers": [ "Microsoft Windows", "Microsoft Corporation" ],
    "thumbprints": [],
    "allowSubjectMatch": true,
    "checkRevocation": false
  },
  "intel": {
    "enabled": true,
    "feedPath": "intel/feeds",
    "hitScore": 60
  },
  "response": {
    "useEncryptedVault": true,
    "quarantineVaultPath": "quarantine",
    "playbookPath": "",
    "triageOutputPath": "triage",
    "isolationAllowlist": []
  },
  "api": {
    "enableSurfaceInventory": true,
    "control": {
      "enabled": false,
      "address": "127.0.0.1",
      "port": 8787,
      "token": "",
      "allowActions": false
    },
    "studio": {
      "allowedHosts": [ "localhost", "127.0.0.1" ],
      "allowMutatingMethods": false,
      "allowInsecureHttp": false,
      "maxRequestsPerSecond": 5.0,
      "maxResponseBytes": 8388608
    }
  },
  "telemetry": {
    "jsonlPath": "incidents.jsonl",
    "auditPath": "audit.log",
    "format": "native",
    "enableMetrics": true,
    "syslog": { "enabled": false, "host": "127.0.0.1", "port": 514, "protocol": "udp", "appName": "BruceEDR" },
    "webhook": { "enabled": false, "url": "" }
  },
  "watchlist": {
    "enabled": true,
    "alertOnEveryHit": true,
    "entries": [
      {
        "match": "name",
        "value": "mimikatz",
        "action": "quarantine",
        "note": "credential-dumping tool; never legitimate on a managed endpoint",
        "techniques": [ "T1003.001" ],
        "enabled": false
      },
      {
        "match": "cmdline",
        "value": "-enc",
        "action": "score",
        "score": 25,
        "note": "base64-encoded PowerShell; scores rather than convicts",
        "enabled": false
      }
    ]
  },
  "service": {
    "serviceName": "BruceEDR",
    "heartbeatPath": "C:\\ProgramData\\BruceEDR\\heartbeat",
    "heartbeatIntervalSeconds": 5,
    "watchdogStaleSeconds": 30
  }
}
