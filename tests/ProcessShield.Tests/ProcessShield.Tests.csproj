<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>ProcessShield.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ProcessShield.csproj" />
    <!-- Deliberately NOT referencing gui/ProcessShield.Gui: pulling a WPF project in here
         forces UseWPF on the test assembly, which swaps the implicit-using set and breaks
         every unrelated test that uses System.IO. GuiResourceTests reads the GUI sources
         as text instead, which needs no reference and no WPF. -->
  </ItemGroup>

</Project>
